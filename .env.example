# Opcional. Solo claves PÚBLICAS (anon). Nunca pongas aquí la service_role.
# Si se dejan vacías, el sitio usa los precios del catálogo y no consulta Supabase.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# --- Publicidad y medición con Meta (PLANEADO; hoy NO hay Pixel ni CAPI instalados) ---
# Panel de cookies (aceptar / rechazar / configurar): apagado por defecto. Es una bandera PÚBLICA, no un secreto.
PUBLIC_MARKETING_CONSENT=
# Cuando existan: PUBLIC_META_PIXEL_ID (público) y META_CAPI_ACCESS_TOKEN.
# META_CAPI_ACCESS_TOKEN es un SECRETO DE SERVIDOR: NUNCA con prefijo PUBLIC_, nunca en el navegador ni en Git
# (se configura solo como variable de entorno del servidor en Vercel). No se deja ningún valor aquí.
