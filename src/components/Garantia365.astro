---
/* Bloque de garantía (365 días según el catálogo 2026) con el mostrador de productos y los tres pasos para cotizar. */
import { Image } from 'astro:assets';
import { bySlug, productImage, waAdvice } from '../data/catalog';
import seal from '../assets/sello-365.webp';
const img = (slug: string) => productImage(bySlug(slug)!.images[0].file);
const objs = [
  ['maquina-de-hidrogel-11-9-sellado-automatico-uv-oemp2300', 'o1'], ['hidrogel-mate', 'o2'], ['cargador-67w-tc-tc-gan-ultra-carga-rapida', 'o3'],
  ['power-bank-10-000-mah-22-5w-multipuerto', 'o4'], ['pen-hidrogel', 'o5'],
] as const;
---
<section class="gar on-light" id="garantia" aria-labelledby="gar-t" data-gar>
  <div class="wrap gar__grid">
    <div class="gar__copy" data-reveal>
      <div class="gar__num" aria-hidden="true"><span data-count="365">365</span></div>
      <h2 id="gar-t">días de garantía en todo el catálogo.</h2>
      <p>Así lo indica el catálogo 2026 para cada referencia. Las máquinas de hidrogel indican garantía de 1 año.</p>
      <p class="gar__fine">Las condiciones de cobertura se confirman con tu asesor antes de la compra. <a href="/soporte#garantia">Ver garantía y soporte</a></p>
    </div>
    <div class="gar__side">
      <div class="gar__counter" data-reveal style="--i:1">
        <div class="gar__cap"><Image src={seal} alt="" width={56} height={51} /><div><h3>¿Tienes tienda o servicio técnico?</h3><p>Equipos, insumos y accesorios de mostrador en un solo proveedor.</p></div></div>
        <span class="gar__top" aria-hidden="true"></span>
        {objs.map(([slug, c], i) => (
          <span class={`gar__obj ${c}`} style={`--k:${i}`} aria-hidden="true"><Image src={img(slug)} alt="" widths={[240, 420]} sizes="(max-width: 800px) 30vw, 200px" loading="lazy" /></span>
        ))}
      </div>
      <div class="gar__seq">
        <a href="/hidrogel" data-reveal style="--i:2"><i>01</i><b>Explorar equipos</b><span>Máquinas de corte, secado UV y laminación.</span></a>
        <a href="/hidrogel" data-reveal style="--i:3"><i>02</i><b>Elegir insumos</b><span>Hidrogel por uso y acabado, cuchillas y herramientas.</span></a>
        <a href={waAdvice} target="_blank" rel="noopener" data-reveal style="--i:4"><i>03</i><b>Pedir asesoría</b><span>Un asesor confirma precio, disponibilidad y entrega.</span></a>
      </div>
    </div>
  </div>
</section>

<script>
  // Conteo 0 → 365 al entrar en pantalla (sin movimiento reducido).
  const n = document.querySelector<HTMLElement>('[data-gar] [data-count]');
  if (n && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const end = Number(n.dataset.count);
    n.textContent = '0';
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const tick = (t: number) => { const k = Math.min(1, (t - t0) / 1400); n.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    }, { threshold: 0.4 });
    io.observe(n);
  }
</script>

<style>
  .gar { background: linear-gradient(180deg, #F5FBFC, var(--bruma)); color: var(--texto); padding: clamp(72px, 10vw, 136px) 0; overflow: clip; }
  .gar__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .gar__num { font-family: var(--font-display); font-weight: 800; font-size: clamp(120px, 20vw, 280px); line-height: .82; letter-spacing: -.06em; font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--tinta-2) 20%, var(--asombro-turmalina) 70%, var(--cian-realidad-virtual)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .gar__copy h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); margin-top: 14px; color: var(--tinta-2); }
  .gar__copy p { margin-top: 12px; max-width: 48ch; color: var(--texto-suave); }
  .gar__fine { font-size: .9rem; }
  .gar__fine a { color: var(--confianza-indigo); font-weight: 600; }
  .gar__counter { position: relative; aspect-ratio: 16 / 9; border-radius: var(--r-lg); overflow: hidden; background: radial-gradient(70% 60% at 50% 30%, #fff, #E1F2F5); border: 1px solid var(--linea); box-shadow: 0 30px 60px rgba(15,36,54,.1); }
  .gar__cap { position: absolute; left: 22px; top: 20px; right: 22px; display: flex; gap: 14px; align-items: flex-start; z-index: 2; }
  .gar__cap h3 { font-size: 1.15rem; color: var(--tinta-2); }
  .gar__cap p { font-size: .9rem; color: var(--texto-suave); margin: 4px 0 0; }
  .gar__top { position: absolute; left: 0; right: 0; bottom: 0; height: 24%; background: linear-gradient(180deg, #D3EBEF, #BFDDE3); border-top: 1px solid rgba(255,255,255,.9); }
  .gar__obj { position: absolute; bottom: 16%; animation: garFloat 5s ease-in-out calc(var(--k) * -1.1s) infinite; }
  .gar__obj :global(img) { display: block; width: 100%; height: auto; filter: drop-shadow(0 12px 14px rgba(15,36,54,.18)); }
  .o1 { left: 22%; width: 40%; } .o2 { left: 6%; width: 15%; } .o3 { left: 63%; width: 13%; } .o4 { left: 77%; width: 15%; } .o5 { left: 92%; width: 5%; }
  @keyframes garFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  .gar__seq { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 14px; }
  .gar__seq a { display: flex; flex-direction: column; gap: 4px; padding: 18px; border-radius: var(--r-md); background: #fff; border: 1px solid var(--linea); text-decoration: none; color: var(--texto); transition: transform .3s var(--ease), box-shadow .3s; }
  .gar__seq a:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(15,36,54,.1); }
  .gar__seq i { font-style: normal; font-family: var(--font-display); font-weight: 700; color: var(--asombro-turmalina); }
  .gar__seq b { font-family: var(--font-display); color: var(--tinta-2); }
  .gar__seq span { font-size: .88rem; color: var(--texto-suave); line-height: 1.4; }
  @media (max-width: 900px) { .gar__grid { grid-template-columns: 1fr; } .gar__seq { grid-template-columns: 1fr; } .gar__cap p { display: none; } }
  @media (prefers-reduced-motion: reduce) { .gar__obj { animation: none; } }
</style>
