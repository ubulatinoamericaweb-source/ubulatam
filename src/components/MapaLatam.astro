---
/* Mapa de Latinoamérica con los productos del catálogo levitando sobre el territorio.
   Geometría y posiciones: src/data/mapa-latam.json (se regenera con scripts/mapa-latam.mjs). Sin cobertura, rutas ni sedes:
   el mapa es decorativo y los productos solo se reparten por el territorio. */
import { getImage } from 'astro:assets';
import { productImage } from '../data/catalog';
import map from '../data/mapa-latam.json';

// Frases cortas de marca (textos ya usados en el sitio). x/y = posición sobre el océano en % del mapa (escritorio).
const lines = [
  { k: 'UBU Latinoamérica', t: 'Tecnología e insumos para impulsar tu negocio.', side: 'r', y: 3 },
  { k: 'Hidrogel', t: 'Hidrogel a la medida, cortado en tu mostrador.', side: 'l', y: 35 },
  { k: 'Un solo proveedor', t: 'Equipos, insumos y accesorios en un solo proveedor.', side: 'l', y: 53 },
  { k: 'Para tu negocio', t: 'Pensado para tiendas y técnicos de celulares.', side: 'l', y: 71 },
  { k: 'Equipos', t: 'Máquinas de corte, secado UV y laminación.', side: 'r', y: 78 },
  { k: 'Garantía', t: '365 días de garantía.', side: 'r', y: 92 },
];

const items = await Promise.all(map.items.map(async (it) => {
  const src = productImage(it.file);
  const img = await getImage({ src, width: Math.min(it.px * 2, src.width), format: 'webp', quality: 80 });
  return { ...it, src: img.src };
}));
const words = (t: string) => t.split(' ');
---
<section class="lam" id="mapa-latam" aria-labelledby="lam-t" data-lam>
  <h2 id="lam-t" class="sr-only">UBU Latinoamérica: tecnología e insumos para impulsar tu negocio</h2>
  <div class="lam__stage" style={`--ar:${map.H / map.W}`}>
    <div class="lam__map">
      <svg class="lam__svg" viewBox={`0 0 ${map.W} ${map.H}`} aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="lamLand" x1="0" y1="0" x2=".35" y2="1"><stop offset="0" stop-color="#3ECCD6" /><stop offset="1" stop-color="#01DCEF" /></linearGradient>
        </defs>
        <path class="lam__muted" d={map.muted} />
        <path class="lam__glow" d={map.main} />
        <path class="lam__land" d={map.main} />
      </svg>
      <div class="lam__items" aria-hidden="true">
        {items.map((it) => (
          <span class={`lp lp--${it.size}${it.m ? '' : ' lp--x'}`} style={`left:${it.x}%;top:${it.y}%;--s:${it.px}px;--d:-${it.d}s;--g:-${it.g}s;--img:url(${it.src})`}>
            <i class="lp__halo"></i><i class="lp__sh"></i>
            <span class="lp__f"><img src={it.src} alt="" width={it.px} height={it.px} loading="lazy" decoding="async" /><i class="lp__shine"></i><i class="lp__gl"></i></span>
          </span>
        ))}
      </div>
    </div>
    {lines.map((l, i) => (
      <p class={`lq lq--${l.side}`} style={`--y:${l.y};--o:${i < 2 ? i - 10 : i}`}>
        <span class="lq__k">{l.k}</span>
        <span class="lq__t">{words(l.t).map((w, j) => <span class="lq__w"><span style={`--wi:${j}`}>{w}</span></span>)}</span>
      </p>
    ))}
  </div>
</section>

<script>
  const s = document.querySelector<HTMLElement>('[data-lam]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (s && !reduce && 'IntersectionObserver' in window) {
    s.classList.add('lam--anim');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    s.querySelectorAll('.lp, .lq').forEach((el) => io.observe(el));
    // Las animaciones en bucle solo corren mientras la sección está en pantalla.
    new IntersectionObserver(([e]) => s.classList.toggle('is-live', e.isIntersecting)).observe(s);
  }
</script>

<style>
  .lam { position: relative; color-scheme: light; color: var(--tinta-2); overflow: clip;
    background: radial-gradient(70% 40% at 70% 8%, rgba(1,220,239,.10), transparent 70%), linear-gradient(180deg, #F4FBFD 0%, #EAF6F8 55%, #F5FBFC 100%);
    padding: clamp(64px, 9vw, 128px) var(--gut) clamp(72px, 10vw, 140px); }
  .lam__stage { position: relative; display: grid; width: min(1100px, 100%); margin-inline: auto; }
  .lam__map, .lq { grid-area: 1 / 1; }
  .lam__map { position: relative; aspect-ratio: 1 / var(--ar); }
  .lam__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lam__land { fill: url(#lamLand); fill-opacity: .42; stroke: #6FE7F2; stroke-width: .9; stroke-linejoin: round; }
  .lam__glow { fill: none; stroke: #01DCEF; stroke-opacity: .16; stroke-width: 6; stroke-linejoin: round; }
  .lam__muted { fill: #B7C4CA; fill-opacity: .3; stroke: #fff; stroke-width: .7; }

  /* Frases: sobre el océano en escritorio (margen en % del ancho = % del alto × proporción del mapa) */
  .lq { position: relative; z-index: 2; align-self: start; max-width: 34%; margin: calc(var(--y) * var(--ar) * 1%) 0 0; pointer-events: none; }
  .lq--r { justify-self: end; text-align: left; max-width: 29%; }
  .lq--l { justify-self: start; }
  .lq__k { display: inline-flex; align-items: center; gap: .7em; font-family: var(--font-display); font-weight: 600; font-size: .74rem; letter-spacing: .22em; text-transform: uppercase; color: var(--asombro-turmalina); margin-bottom: 12px; }
  .lq__k::before { content: ''; width: 32px; height: 2px; border-radius: 2px; background: linear-gradient(90deg, #3ECCD6, #01DCEF); transform-origin: left; }
  .lq__t { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 2.7vw, 2.4rem); line-height: 1.08; letter-spacing: -.025em; color: var(--tinta-2); text-wrap: balance; }
  .lq__w { display: inline-block; overflow: clip; overflow-clip-margin: .12em; vertical-align: bottom; padding-bottom: .06em; margin-right: .26em; }
  .lq__w > span { display: inline-block; }

  /* Productos */
  .lp { --z: 1; --w: calc(var(--s) * var(--z)); position: absolute; width: var(--w); height: var(--w); margin: calc(var(--w) / -2) 0 0 calc(var(--w) / -2); pointer-events: none; }
  .lp--l { --dur: 6.4s; --a: -14px; --gd: 5.2s; --sd: 7s; z-index: 1; }
  .lp--m { --dur: 4.8s; --a: -10px; --gd: 6.4s; --sd: 8.5s; }
  .lp--s { --dur: 3.6s; --a: -7px; --gd: 7.6s; --sd: 10s; }
  .lp__f { position: relative; display: block; width: 100%; height: 100%; animation: lpFloat var(--dur) ease-in-out var(--d) infinite; }
  .lp__f img { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 6px 10px rgba(15,36,54,.14)); }
  .lp__halo { position: absolute; inset: -18%; border-radius: 50%; background: radial-gradient(closest-side, rgba(1,220,239,.28), rgba(1,220,239,0)); animation: lpHalo var(--dur) ease-in-out var(--d) infinite; }
  .lp__sh { position: absolute; left: 16%; right: 16%; bottom: -14%; height: 14%; border-radius: 50%; background: radial-gradient(closest-side, rgba(15,36,54,.3), rgba(15,36,54,0)); animation: lpShadow var(--dur) ease-in-out var(--d) infinite; }
  /* Brillo que recorre la silueta del producto (la foto hace de máscara) */
  .lp__shine { position: absolute; inset: 0; overflow: hidden; -webkit-mask: var(--img) center / contain no-repeat; mask: var(--img) center / contain no-repeat; }
  .lp__shine::before { content: ''; position: absolute; inset: -10% auto -10% 0; width: 45%; background: linear-gradient(100deg, rgba(255,255,255,0), rgba(255,255,255,.75) 50%, rgba(255,255,255,0)); transform: translateX(-120%) skewX(-14deg); animation: lpSweep var(--sd) ease-in-out var(--g) infinite; }
  .lp__gl { position: absolute; top: -6%; right: -4%; width: 30%; height: 30%; background: radial-gradient(circle, #fff 0 18%, #BFF7FC 32%, rgba(1,220,239,0) 70%); clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%); opacity: 0; animation: lpGlint var(--gd) ease-in-out var(--g) infinite; }
  @keyframes lpFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(var(--a)); } }
  @keyframes lpShadow { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(.72); opacity: .45; } }
  @keyframes lpHalo { 0%, 100% { opacity: .55; transform: scale(.92); } 50% { opacity: 1; transform: scale(1.05); } }
  @keyframes lpSweep { 0%, 62% { transform: translateX(-120%) skewX(-14deg); } 82%, 100% { transform: translateX(260%) skewX(-14deg); } }
  @keyframes lpGlint { 0%, 84%, 100% { opacity: 0; transform: scale(.3) rotate(0); } 91% { opacity: 1; transform: scale(1) rotate(45deg); } }

  /* Entrada con el scroll (solo con JS y sin movimiento reducido) */
  .lam--anim .lp { opacity: 0; transform: translateY(28px) scale(.82); transition: opacity .9s var(--ease), transform 1.1s var(--ease); }
  .lam--anim .lp.is-in { opacity: 1; transform: none; }
  .lam--anim .lq__k { opacity: 0; transition: opacity .6s var(--ease); }
  .lam--anim .lq__k::before { transform: scaleX(0); transition: transform .8s var(--ease) .1s; }
  .lam--anim .lq__w > span { transform: translateY(105%); transition: transform .9s var(--ease); transition-delay: calc(.15s + var(--wi) * 60ms); }
  .lam--anim .lq.is-in .lq__k { opacity: 1; }
  .lam--anim .lq.is-in .lq__k::before { transform: none; }
  .lam--anim .lq.is-in .lq__w > span { transform: none; }
  .lam:not(.is-live) :is(.lp__f, .lp__sh, .lp__halo, .lp__gl),
  .lp:not(.is-in) :is(.lp__f, .lp__sh, .lp__halo, .lp__gl) { animation-play-state: paused; }
  .lam:not(.is-live) .lp__shine::before, .lam--anim .lp:not(.is-in) .lp__shine::before { animation-play-state: paused; }

  @media (max-width: 899px) {
    .lam__stage { display: flex; flex-direction: column; gap: 28px; }
    .lam__map { order: 0; }
    .lq, .lq--r { order: var(--o); max-width: 30ch; margin: 0; }
    .lq--r { align-self: flex-end; }
    .lq__t { font-size: clamp(1.35rem, 6vw, 1.8rem); }
    .lp { --z: .5; }
    .lp--x { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lp__f, .lp__sh, .lp__halo, .lp__gl, .lp__shine::before { animation: none; }
    .lp__gl, .lp__shine { display: none; }
  }
</style>
