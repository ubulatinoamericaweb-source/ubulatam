---
import '@fontsource-variable/outfit';
import '@fontsource/questrial';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import UbuFace from '../components/UbuFace.astro';
import Channels from '../components/Channels.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { WA_PATH, CART_PATH } from '../data/icons';
import { WA_DISPLAY, waGeneric } from '../data/catalog';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Imagen Open Graph (ruta absoluta dentro del sitio). */
  image?: string;
  type?: 'website' | 'product';
  jsonLd?: object | object[];
  /** Clase de fondo del <body> para que el overscroll combine con la página. */
  bodyClass?: string;
}
const { title, description, noindex = false, image = '/og.png', type = 'website', jsonLd, bodyClass = '' } = Astro.props;
const site = Astro.site ?? new URL('https://www.ubulatinoamerica.com');
// Ruta limpia: sin barra final, sin «index» y sin «.html» (el build genera archivos .html, pero las URLs públicas no los llevan)
const path = Astro.url.pathname.replace(/\/$/, '').replace(/\/index(\.html)?$/, '').replace(/\.html$/, '') || '/';
// Enlaces de comparación con /realista: solo en desarrollo (o si se compila con PUBLIC_ENABLE_REALISTA=1)
// Panel de cookies de marketing (Meta, planeado): apagado por defecto; se activa compilando con PUBLIC_MARKETING_CONSENT=1
const consentUI = import.meta.env.PUBLIC_MARKETING_CONSENT === '1';
const lab = import.meta.env.DEV || import.meta.env.PUBLIC_ENABLE_REALISTA === '1';
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = path === '/' ? title : `${title} · UBU Latinoamérica`;

const nav = [
  { href: '/conectividad', label: 'Conectividad' },
  { href: '/hidrogel', label: 'Hidrogel' },
  { href: '/para-tu-negocio', label: 'Para tu negocio' },
  { href: '/soporte', label: 'Soporte' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/contacto', label: 'Contacto' },
];
const isCur = (h: string) => path === h;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UBU Latinoamérica',
  url: site.href,
  logo: new URL('/brand/ubu-logo.svg', site).href,
  contactPoint: [{ '@type': 'ContactPoint', telephone: '+573043724012', contactType: 'sales', availableLanguage: 'es' }],
};
const ld = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0A1A29" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="UBU Latinoamérica" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:type" content={type === 'product' ? 'website' : type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Saltar al contenido</a>
    <header class="site-header" data-header>
      <div class="site-header__bar">
        <a class="brand" href="/" aria-label="UBU Latinoamérica, inicio"><Logo variant="blanco" /></a>
        <nav class="nav" aria-label="Principal">
          {nav.map((n) => <a href={n.href} aria-current={isCur(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="quote-pill" href="/carrito" data-cart-link aria-label="Carrito, vacío"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CART_PATH} /></svg><span class="t">Carrito</span><span class="quote-pill__n" data-quote-count data-n="0">0</span></a>
          <a class="btn btn--wa btn--sm" href={waGeneric} target="_blank" rel="noopener">WhatsApp</a>
          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" aria-label="Abrir menú" data-menu-btn>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <nav class="menu-panel" id="menu-panel" aria-label="Menú móvil" hidden data-menu-panel>
        {nav.map((n) => <a href={n.href} aria-current={isCur(n.href) ? 'page' : undefined}>{n.label}</a>)}
        <a href="/catalogo">Catálogo completo</a>
        {lab && (path === '/' || path === '/realista') && <a href={path === '/' ? '/realista' : '/'}>{path === '/' ? 'Comparar: versión realista (prueba)' : 'Ver la versión animada actual'}</a>}
        <a class="btn btn--wa" href={waGeneric} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
      </nav>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer on-dark">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <Logo variant="blanco" />
            <p>Tecnología e insumos para tiendas y técnicos de celulares. Catálogo 2026 con precios de referencia en COP.</p>
            <Channels />
          </div>
          <div>
            <h3>Catálogo</h3>
            <ul>
              <li><a href="/conectividad">Conectividad</a></li>
              <li><a href="/hidrogel">Hidrogel</a></li>
              <li><a href="/catalogo">Catálogo completo</a></li>
              <li><a href="/carrito">Carrito de pedido</a></li>
              <li><a href="/descargas/catalogo-ubu-2026.pdf" download>Catálogo en PDF</a></li>
            </ul>
          </div>
          <div>
            <h3>UBU</h3>
            <ul>
              <li><a href="/nosotros">Nosotros</a></li>
              <li><a href="/para-tu-negocio">Para tu negocio</a></li>
              <li><a href="/soporte">Soporte</a></li>
              <li><a href="/contacto">Contacto</a></li>
              <li><a href="/ubicacion">Ubicación</a></li>
            </ul>
          </div>
          <div>
            <h3>Escríbenos</h3>
            <ul>
              <li><a href={waGeneric} target="_blank" rel="noopener">WhatsApp {WA_DISPLAY}</a></li>
              <li>Centro Empresarial Hayuelos</li>
              <li><a href="/privacidad">Privacidad y datos</a></li>
              <li><a href="/cookies">Cookies</a></li>
              <li><a href="/terminos">Términos de uso</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          {consentUI && <button type="button" class="linkbtn" data-consent-open>Preferencias de cookies</button>}
          <span>© {new Date().getFullYear()} UBU Latinoamérica®. Todos los derechos reservados.</span>
          <span>Precios en pesos colombianos (COP), de referencia; se confirman al cotizar.</span>
        </div>
      </div>
      <div class="footer-watermark" aria-hidden="true"><UbuFace tone="blanco" eyes={false} /></div>
    </footer>

    {lab && path === '/' && <a class="cmp-toggle" href="/realista">Comparar: versión realista (prueba) →</a>}
    <a class="wa-float" href={waGeneric} target="_blank" rel="noopener" aria-label="Cotizar por WhatsApp">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={WA_PATH} fill="currentColor" /></svg>
    </a>
    {consentUI && <ConsentBanner />}
    <script>import '../scripts/core';</script>
  </body>
</html>
