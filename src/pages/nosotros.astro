---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import UbuFace from '../components/UbuFace.astro';
import { bySlug, productImage, waAdvice } from '../data/catalog';
import seal from '../assets/sello-365.webp';

const img = (s: string) => productImage(bySlug(s)!.images[0].file);
// Proporción áurea (manual p. 4): rectángulo áureo y espiral de Fibonacci.
const PHI = 1.6180339887, H = 377, W = Math.round(H * PHI);
let spiral = `M0 ${H}`; let hx = 0, hy = -1, px = 0, py = H, r = H;
for (let k = 0; k < 8; k++) {
  const nx = -hy, ny = hx;
  const ex = px + r * hx + r * nx, ey = py + r * hy + r * ny;
  spiral += ` A${r.toFixed(1)} ${r.toFixed(1)} 0 0 1 ${ex.toFixed(1)} ${ey.toFixed(1)}`;
  px = ex; py = ey; hx = nx; hy = ny; r = r / PHI;
}
// Paleta del manual (p. 5-6), con HEX y RGB tal como figuran.
const ribbons = [
  { n: 'Asombro Turmalina', hex: '#41B9C1', rgb: '65, 185, 193', fg: '#05101B', rot: -4 },
  { n: 'Cian Realidad Virtual', hex: '#01DCEF', rgb: '1, 220, 239', fg: '#05101B', rot: 3 },
  { n: 'Azul Silicon Valley', hex: '#4293D0', rgb: '66, 147, 208', fg: '#fff', rot: -3 },
  { n: 'Confianza Índigo', hex: '#405BA5', rgb: '64, 91, 165', fg: '#fff', rot: 4 },
  { n: 'Verde Armonía · Verde Cobre Oxidado', hex: '#56B28E', rgb: '86, 178, 142', fg: '#05101B', rot: -2 },
  { n: 'Gris Guernica', hex: '#575756', rgb: '87, 87, 86', fg: '#fff', rot: 3 },
  { n: 'Blanco Pureza', hex: '#FFFFFF', rgb: '255, 255, 255', fg: '#05101B', rot: -3 },
];
---
<Base title="Nosotros" description="UBU Latinoamérica es una marca de tecnología para el mercado de accesorios de celular: hidrogel, cargadores, cables, audio, vidrios y baterías. Conoce la identidad de la marca y dónde atendemos.">

  <!-- 1 · ESCENA DE MARCA -->
  <section class="nh on-dark" data-orbit aria-labelledby="nh-t">
    <div class="nh__bg" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="wrap nh__grid">
      <div class="nh__copy">
        <nav aria-label="Ruta de navegación"><ol class="crumbs"><li><a href="/">Inicio</a></li><li aria-current="page">Nosotros</li></ol></nav>
        <p class="kicker">Nosotros</p>
        <h1 id="nh-t">Una marca con cara amable para tu mostrador.</h1>
        <p class="lede">UBU Latinoamérica reúne máquinas de corte, láminas de hidrogel e insumos de instalación, junto con accesorios de mostrador para celular.</p>
        <p class="nh__cta"><a class="btn" href="#simbolo">Conoce el símbolo</a><a class="btn btn--ghost" href="/catalogo">Ver catálogo</a></p>
      </div>
      <div class="nh__scene" aria-hidden="true">
        <svg class="nh__rings" viewBox="0 0 600 600"><circle cx="300" cy="300" r="280" /><circle cx="300" cy="300" r="222" class="d" /><circle cx="300" cy="300" r="168" /></svg>
        <div class="nh__face"><UbuFace tone="cian" /></div>
        <Image class="orb orb--a" data-depth="26" src={img('cargador-67w-tc-tc-gan-ultra-carga-rapida')} alt="" widths={[200, 320]} sizes="160px" loading="eager" />
        <Image class="orb orb--b" data-depth="-18" src={img('hidrogel-mate')} alt="" widths={[200, 320]} sizes="130px" loading="eager" />
        <Image class="orb orb--c" data-depth="34" src={img('maquina-de-hidrogel-11-9-sellado-automatico-uv-oemp2300')} alt="" widths={[260, 420]} sizes="220px" loading="eager" />
        <Image class="orb orb--d" data-depth="-28" src={img('power-bank-10-000-mah-22-5w-multipuerto')} alt="" widths={[200, 320]} sizes="130px" loading="eager" />
      </div>
    </div>
  </section>

  <!-- 2 · QUIÉNES SOMOS (capas) -->
  <section class="who on-light">
    <div class="wrap who__grid">
      <div class="who__big" aria-hidden="true">UBU</div>
      <div class="who__text">
        <p class="kicker">Quiénes somos</p>
        <h2 class="h2">Una marca de tecnología para el mercado de accesorios de celular.</h2>
        <p>Nuestro catálogo 2026 se centra en la protección de hidrogel: equipos para cortarla a la medida, láminas en distintos acabados y las herramientas para instalarla.</p>
        <p>Lo complementamos con cargadores, cables, audio, vidrios blindados y baterías, para que una tienda o un servicio técnico encuentre su surtido en un solo proveedor. Atendemos por WhatsApp y en el Centro Empresarial Hayuelos.</p>
      </div>
    </div>
  </section>

  <!-- 3 · EL SÍMBOLO + PROPORCIÓN ÁUREA -->
  <section class="sym on-dark" id="simbolo" aria-labelledby="sym-t">
    <div class="wrap sym__grid">
      <div class="sym__fig" data-reveal>
        <svg class="gold" viewBox={`-30 -30 ${W + 60} ${H + 60}`} aria-hidden="true">
          <rect x="0" y="0" width={W} height={H} rx="2" class="gold__box" />
          <line x1={H} y1="0" x2={H} y2={H} class="gold__box" />
          <path d={spiral} class="gold__spiral" pathLength="1" />
        </svg>
        <div class="sym__logo"><Logo variant="blanco" label="Logo UBU Latinoamérica" /></div>
      </div>
      <div>
        <p class="kicker">El símbolo</p>
        <h2 id="sym-t" class="h2">Dos ojos turquesa sobre la letra u.</h2>
        <p>El símbolo de UBU es una cara amable. Según el manual de identidad, su misión es representar la marca solo con una imagen, sin acompañarla de letras ni texto.</p>
        <p style="margin-top:14px">La proporción áurea guía las composiciones de la marca: alinea los elementos mediante el rectángulo áureo y la espiral basada en la sucesión de Fibonacci.</p>
        <div class="sym__iso" aria-hidden="true"><div><UbuFace tone="color" /></div><div class="on-white"><UbuFace tone="blanco" /></div><div class="cy"><UbuFace tone="cian" /></div></div>
      </div>
    </div>
  </section>

  <!-- 4 · PALETA -->
  <section class="pal on-light" aria-labelledby="pal-t">
    <div class="wrap">
      <p class="kicker">Gama cromática</p>
      <h2 id="pal-t" class="h2" style="max-width:20ch">Colores que equilibran profesionalismo, confianza y sofisticación.</h2>
      <ul class="ribbons">
        {ribbons.map((c, i) => (
          <li class="ribbon" style={`--bg:${c.hex};--fg:${c.fg};--rot:${c.rot}deg;--i:${i}`} data-reveal>
            <b>{c.n}</b>
            <span>HEX {c.hex} · RGB {c.rgb}</span>
          </li>
        ))}
      </ul>
      <div class="type">
        <p><small>Tipografía principal según el manual</small><span class="type__a">Harabara Mais</span></p>
        <p><small>Tipografía secundaria según el manual</small><span class="type__b">Century Gothic</span></p>
      </div>
    </div>
  </section>

  <!-- 5 · LO QUE OFRECEMOS -->
  <section class="off on-dark" aria-labelledby="off-t">
    <div class="wrap">
      <p class="kicker">Qué ofrecemos</p>
      <h2 id="off-t" class="h2">Dos líneas que se complementan en el mostrador.</h2>
      <div class="off__grid">
        <a class="line line--h" href="/hidrogel" data-reveal>
          <span class="line__word" aria-hidden="true">Hidrogel</span>
          <Image class="l1" src={img('maquina-de-hidrogel-21-pulgadas')} alt="" widths={[300, 480]} sizes="280px" loading="lazy" />
          <Image class="l2" src={img('hidrogel-mate')} alt="" widths={[200, 320]} sizes="150px" loading="lazy" />
          <span class="line__body"><strong>Hidrogel</strong>Máquinas de corte libres de códigos, secado UV, laminación y láminas HD, mate, antiblue, antiespía, UV, 360, para tablet y para máquina VT8PRO.<em>Ver hidrogel →</em></span>
        </a>
        <a class="line line--c" href="/conectividad" data-reveal style="--i:1">
          <span class="line__word" aria-hidden="true">Conectividad</span>
          <Image class="l1" src={img('cargador-pd-45w-gan-super-carga-rapida-tc-tc')} alt="" widths={[300, 480]} sizes="260px" loading="lazy" />
          <Image class="l2" src={img('parlante-x7-con-inteligencia-artificial')} alt="" widths={[200, 320]} sizes="130px" loading="lazy" />
          <span class="line__body"><strong>Conectividad</strong>Cargadores, cables, power bank, audio, vidrios blindados, parlantes y baterías para iPhone.<em>Ver conectividad →</em></span>
        </a>
      </div>
    </div>
  </section>

  <!-- 6 · GARANTÍA Y UBICACIÓN -->
  <section class="vis on-light">
    <div class="wrap vis__grid">
      <div class="seal" data-reveal>
        <svg viewBox="0 0 300 300" class="seal__ring" aria-hidden="true"><defs><path id="circ" d="M150 150 m-120 0 a120 120 0 1 1 240 0 a120 120 0 1 1 -240 0" /></defs>
          <text><textPath href="#circ" startOffset="0">· 365 días de garantía · según el catálogo 2026 · cada referencia ·</textPath></text></svg>
        <Image src={seal} alt="365 días de garantía" width={150} height={136} />
      </div>
      <div data-reveal>
        <p class="kicker">Garantía y atención</p>
        <h2 class="h2">365 días de garantía en todos los productos.</h2>
        <p>Es el compromiso que, según el catálogo 2026, acompaña cada referencia. Las máquinas de hidrogel indican garantía de 1 año.</p>
        <div class="vis__loc"><b>Visítanos</b><span>Centro Empresarial Hayuelos</span><a href="/ubicacion">Ver ubicación →</a></div>
        <p style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px"><a class="btn btn--dark" href="/para-tu-negocio">Para tu negocio</a><a class="btn btn--wa" href={waAdvice} target="_blank" rel="noopener">Hablemos por WhatsApp</a></p>
      </div>
    </div>
  </section>
  <script>import '../scripts/inner';</script>
</Base>

<style>
  .nh { position: relative; min-height: min(100svh, 900px); display: grid; align-items: center; padding: calc(var(--header-h) + 50px) 0 70px; overflow: hidden; isolation: isolate;
    background: radial-gradient(60% 70% at 78% 45%, rgba(65,185,193,.4), transparent 70%), radial-gradient(45% 60% at 5% 0%, rgba(64,91,165,.6), transparent 70%), linear-gradient(160deg, #0B2236, #05101B); }
  .nh__bg i { position: absolute; border: 1.5px solid rgba(1,220,239,.22); border-radius: 50%; }
  .nh__bg i:nth-child(1) { width: 70vw; aspect-ratio: 1; right: -20vw; top: -20vw; } .nh__bg i:nth-child(2) { width: 46vw; aspect-ratio: 1; left: -12vw; bottom: -18vw; } .nh__bg i:nth-child(3) { width: 30vw; aspect-ratio: 1; left: 36vw; top: 8vh; border-style: dashed; }
  .nh__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 4vw, 60px); align-items: center; }
  .nh h1 { font-size: clamp(2.3rem, 5.4vw, 4.6rem); margin: 14px 0 18px; }
  .nh__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .nh__scene { position: relative; aspect-ratio: 1; width: min(100%, 560px); margin-inline: auto; }
  .nh__rings { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nh__rings circle { fill: none; stroke: rgba(1,220,239,.4); stroke-width: 1.5; transform-origin: 300px 300px; animation: spin 40s linear infinite; }
  .nh__rings .d { stroke-dasharray: 6 14; animation-duration: 60s; animation-direction: reverse; stroke: rgba(255,255,255,.4); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .nh__face { position: absolute; inset: 20%; filter: drop-shadow(0 0 40px rgba(1,220,239,.5)); }
  .orb { position: absolute; height: auto; filter: drop-shadow(0 20px 20px rgba(0,0,0,.5)); transition: translate .5s var(--ease); animation: bob 7s ease-in-out infinite; }
  .orb--a { width: 28%; left: -2%; top: 8%; } .orb--b { width: 22%; right: 4%; top: 0; animation-delay: -2s; } .orb--c { width: 38%; right: -6%; bottom: 8%; animation-delay: -4s; } .orb--d { width: 24%; left: 6%; bottom: 0; animation-delay: -1s; }
  @keyframes bob { 50% { transform: translateY(-12px) rotate(1.5deg); } }
  @media (max-width: 860px) { .nh__grid { grid-template-columns: 1fr; } .nh { min-height: 0; } .nh__scene { width: min(86%, 420px); margin-top: 8px; } }
  @media (prefers-reduced-motion: reduce) { .nh__rings circle, .orb { animation: none; } }

  .who { position: relative; padding: clamp(70px, 9vw, 130px) 0; background: linear-gradient(180deg, #F7FBFC, #EAF6F7); overflow: hidden; }
  .who__big { position: absolute; left: -2%; top: 50%; transform: translateY(-50%); font-family: var(--font-display); font-weight: 800; font-size: clamp(10rem, 34vw, 32rem); line-height: .75; color: transparent; -webkit-text-stroke: 2px rgba(64,91,165,.16); pointer-events: none; letter-spacing: -.04em; }
  .who__grid { position: relative; display: grid; grid-template-columns: .6fr 1.4fr; }
  .who__text { grid-column: 2; display: grid; gap: 14px; } .who__text p { color: var(--texto-suave); }
  @media (max-width: 760px) { .who__grid { grid-template-columns: 1fr; } .who__text { grid-column: 1; } .who__big { opacity: .6; top: 18%; } }

  .sym { background: linear-gradient(180deg, #0A1A29, #0F2436); padding: clamp(70px, 9vw, 130px) 0; position: relative; overflow: hidden; }
  .sym__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(24px, 5vw, 80px); align-items: center; }
  .sym__fig { position: relative; padding: 18px; border-radius: var(--r-lg); background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.14); }
  .gold { display: block; width: 100%; height: auto; }
  .gold__box { fill: none; stroke: rgba(255,255,255,.28); stroke-width: 1.2; }
  .gold__spiral { fill: none; stroke: var(--cian-realidad-virtual); stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .is-in .gold__spiral { animation: draw 3.2s var(--ease) .2s forwards; } @keyframes draw { to { stroke-dashoffset: 0; } }
  .sym__logo { position: absolute; left: 50%; top: 50%; width: 60%; transform: translate(-50%, -50%); }
  .sym p { color: rgba(255,255,255,.82); }
  .sym__iso { display: flex; gap: 14px; margin-top: 28px; } .sym__iso > div { width: 84px; padding: 14px; border-radius: var(--r-md); background: rgba(255,255,255,.08); } .sym__iso .on-white { background: #3C4A57; } .sym__iso .cy { background: #05101B; }
  .sym__iso > div:first-child { background: #fff; }
  @media (max-width: 860px) { .sym__grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .gold__spiral { stroke-dashoffset: 0; animation: none !important; } }

  .pal { padding: clamp(70px, 9vw, 130px) 0; background: linear-gradient(180deg, #EAF6F7, #fff); overflow: hidden; }
  .ribbons { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 0; max-width: 780px; margin-inline: auto; }
  .ribbon { display: grid; gap: 4px; padding: 18px 28px; margin-top: -10px; border-radius: 18px; background: var(--bg); color: var(--fg); transform: rotate(var(--rot)); box-shadow: 0 16px 30px -18px rgba(5,16,27,.55); border: 1px solid rgba(0,0,0,.08); transition: transform .5s var(--ease); }
  .ribbon:hover { transform: rotate(0) scale(1.03); z-index: 2; } .ribbon b { font-family: var(--font-display); font-size: 1.25rem; } .ribbon span { font-size: .95rem; opacity: .9; }
  .type { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 54px; } .type p { padding: 24px; border-radius: var(--r-md); background: #fff; border: 1px solid var(--linea); display: grid; gap: 6px; } .type small { color: var(--texto-suave); }
  .type__a { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; letter-spacing: .02em; } .type__b { font-family: var(--font-body); font-size: clamp(1.8rem, 3.6vw, 2.8rem); }
  @media (max-width: 640px) { .type { grid-template-columns: 1fr; } .ribbon { padding: 16px 20px; } }

  .off { padding: clamp(70px, 9vw, 130px) 0; background: radial-gradient(60% 60% at 90% 0%, rgba(64,91,165,.4), transparent 70%), var(--tinta-1); }
  .off__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(14px, 2.4vw, 28px); margin-top: 34px; }
  .line { position: relative; display: block; min-height: 420px; border-radius: var(--r-lg); overflow: hidden; text-decoration: none; isolation: isolate; border: 1px solid rgba(255,255,255,.16); transition: transform .5s var(--ease); }
  .line:hover { transform: translateY(-8px); } .line--h { background: linear-gradient(160deg, #1B5C70, #0B2A3C); } .line--c { background: linear-gradient(160deg, #1F2F66, #0A1530); }
  .line__word { position: absolute; left: 4%; top: 6%; font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 8vw, 6.5rem); color: transparent; -webkit-text-stroke: 1.5px rgba(255,255,255,.28); letter-spacing: -.03em; z-index: -1; }
  .line .l1 { position: absolute; right: 4%; top: 12%; width: 56%; height: auto; filter: drop-shadow(0 24px 24px rgba(0,0,0,.45)); transition: transform .6s var(--ease); } .line .l2 { position: absolute; right: 52%; top: 30%; width: 28%; height: auto; filter: drop-shadow(0 20px 20px rgba(0,0,0,.45)); transition: transform .6s var(--ease); }
  .line:hover .l1 { transform: translateY(-10px) rotate(-2deg); } .line:hover .l2 { transform: translateY(-6px) rotate(3deg); }
  .line__body { position: absolute; left: 14px; right: 14px; bottom: 14px; padding: 18px 20px; border-radius: var(--r-md); background: rgba(5,16,27,.62); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.16); color: #fff; display: grid; gap: 6px; font-size: .98rem; }
  .line__body strong { font-family: var(--font-display); font-size: 1.5rem; } .line__body em { font-style: normal; font-family: var(--font-display); font-weight: 600; color: var(--cian-realidad-virtual); }
  @media (max-width: 860px) { .off__grid { grid-template-columns: 1fr; } .line { min-height: 460px; } }

  .vis { padding: clamp(70px, 9vw, 130px) 0; background: linear-gradient(180deg, #fff, #EAF6F7); }
  .vis__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(24px, 5vw, 80px); align-items: center; }
  .seal { position: relative; width: min(100%, 340px); aspect-ratio: 1; margin-inline: auto; display: grid; place-items: center; }
  .seal img { width: 44%; height: auto; z-index: 1; filter: drop-shadow(0 14px 18px rgba(80,60,0,.35)); }
  .seal__ring { position: absolute; inset: 0; width: 100%; height: 100%; animation: spin 40s linear infinite; } .seal__ring text { font-family: var(--font-display); font-size: 17px; font-weight: 600; letter-spacing: .12em; fill: var(--confianza-indigo); text-transform: uppercase; }
  .vis p { color: var(--texto-suave); } .vis__loc { margin-top: 22px; display: grid; gap: 4px; padding: 18px 22px; border-radius: var(--r-md); background: #fff; border: 1px solid var(--linea); border-left: 5px solid var(--asombro-turmalina); } .vis__loc a { font-weight: 700; font-family: var(--font-display); color: var(--confianza-indigo); }
  @media (max-width: 760px) { .vis__grid { grid-template-columns: 1fr; } .seal { width: min(70%, 260px); } }
  @media (prefers-reduced-motion: reduce) { .seal__ring { animation: none; } }
</style>
