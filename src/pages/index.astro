---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Truck from '../components/Truck.astro';
import UbuFace from '../components/UbuFace.astro';
import Hands from '../components/Hands.astro';
import PcHead from '../components/PcHead.astro';
import Logo from '../components/Logo.astro';
import { byCategory, pick, productImage, cop, waGeneric, waAdvice, waProduct, bySlug } from '../data/catalog';
import seal from '../assets/sello-365.webp';

const featured = pick(
  'cargador-pd-45w-gan-super-carga-rapida-tc-tc', 'cable-240w-tc-tc-con-soporte-cable-plano-1-5-m', 'power-bank-10-000-mah-22-5w-multipuerto',
  'audifonos-oseos-con-pantalla', 'cargador-180w-tc-tc-3-puertos-gan-ultra-carga-rapida', 'maquina-de-hidrogel-21-pulgadas',
  'maquina-de-hidrogel-11-9-sellado-automatico-uv-oemp2300', 'hidrogel-mate',
).sort((a, b) => a.order - b.order);

const glass = pick('parlante-x7-con-inteligencia-artificial', 'parlante-harman-kardon', 'power-bank-10-000-mah-22-5w-multipuerto').sort((a, b) => a.order - b.order);
const glassCopy: Record<string, string> = {
  'parlante-x7-con-inteligencia-artificial': 'X7 IA · inteligencia artificial',
  'parlante-harman-kardon': 'Parlante Bluetooth con luz',
  'power-bank-10-000-mah-22-5w-multipuerto': '22,5 W reales · multipuerto',
};
const nCon = byCategory('conectividad').length;
const nHid = byCategory('hidrogel').length;
const catImg = (slug: string, i = 0) => productImage(bySlug(slug)!.images[i].file);
---
<Base
  title="UBU Latinoamérica · Tecnología e insumos para impulsar tu negocio"
  description="Máquinas de hidrogel, láminas, cargadores, cables, audio y accesorios para tiendas y técnicos de celulares. Catálogo 2026 con precios en COP y cotización por WhatsApp."
  jsonLd={{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'UBU Latinoamérica', url: 'https://www.ubulatinoamerica.com', inLanguage: 'es' }}
>
  <!-- ================= 1 · PORTADA · CAMIÓN ================= -->
  <section class="hero on-dark" data-hero aria-label="Presentación de UBU Latinoamérica">
    <div class="hero__pin" data-hero-pin>
      <div class="hero__sky" aria-hidden="true"></div>
      <div class="hero__floor" aria-hidden="true"></div>
      <div class="hero__road" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <div class="hero__speed" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>

      <div class="hero__truck" data-truck-wrap aria-hidden="true"><Truck /></div>
      <div class="hero__particles" data-particles aria-hidden="true"></div>
      <div class="hero__face" data-hero-face aria-hidden="true"><UbuFace tone="cian" /></div>

      <div class="hero__copy hero__copy--1" data-copy="1">
        <p class="kicker">UBU Latinoamérica</p>
        <h1>Tecnología e insumos para impulsar tu negocio.</h1>
        <p class="lede">Máquinas de hidrogel, láminas, cargadores, cables y accesorios para tiendas y técnicos de celulares.</p>
      </div>
      <div class="hero__copy hero__copy--2" data-copy="2" aria-hidden="false">
        <p class="kicker">Catálogo 2026</p>
        <h2>Todo el surtido de tu mostrador, con un solo proveedor.</h2>
        <p class="lede">Dos líneas: <strong>Conectividad</strong> e <strong>Hidrogel</strong>, con precios de referencia en COP.</p>
        <div class="cta2">
          <a class="btn" href="/catalogo">Ver catálogo</a>
          <a class="btn btn--wa" href={waGeneric} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
        </div>
      </div>
      <div class="hero__cta">
        <a class="btn" href="/catalogo">Ver catálogo</a>
        <a class="btn btn--wa" href={waGeneric} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
        <a class="hero__skip" href="#destacados">Saltar introducción ↓</a>
      </div>
      <div class="hero__progress" aria-hidden="true"><i data-progress></i></div>
    </div>
  </section>

  <!-- ================= 2 · DESTACADOS · RECORRIDO LATERAL ================= -->
  <section class="strip on-light" id="destacados" data-strip aria-labelledby="strip-t">
    <div class="strip__pin" data-strip-pin>
      <svg class="strip__waves" viewBox="0 0 1440 600" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 360 C240 260 420 460 720 360 S1200 240 1440 340" fill="none" stroke="#41B9C1" stroke-opacity=".35" />
        <path d="M0 400 C260 300 440 500 740 400 S1200 280 1440 380" fill="none" stroke="#4293D0" stroke-opacity=".28" />
        <path d="M0 440 C280 340 460 540 760 440 S1200 320 1440 420" fill="none" stroke="#56B28E" stroke-opacity=".3" />
      </svg>
      <p class="strip__ghost" aria-hidden="true">Catálogo<span class="strip__yr"> 2026</span></p>
      <header class="strip__head wrap">
        <div>
          <p class="kicker">Destacados del catálogo 2026</p>
          <h2 id="strip-t">Equipos e insumos que ya están en nuestro mostrador.</h2>
        </div>
        <a class="btn btn--dark" href="/catalogo">Ver todo el catálogo</a>
      </header>
      <div class="strip__viewport" data-viewport>
        <ul class="strip__track" data-track>
          {featured.map((p, i) => (
            <li class="sitem" data-sitem>
              <div class="sitem__stage">
                <Image src={productImage(p.images[0].file)} alt={p.name} widths={[360, 560]} sizes="(max-width: 700px) 70vw, 380px" loading={i < 2 ? 'eager' : 'lazy'} class={p.images[0].alpha ? '' : 'is-blend'} />
                <span class="sitem__floor" aria-hidden="true"></span>
              </div>
              <div class="sitem__info">
                <span class="sitem__type">{p.type}</span>
                <h3><a href={`/${p.slug}`}>{p.name}</a></h3>
                <p class="price" data-sb-price={p.sbSlug}><span data-num>{cop(p.price!)}</span><small>COP</small></p>
                <div class="sitem__actions">
                  <a class="btn btn--sm btn--dark" href={`/${p.slug}`}>Ver ficha</a>
                  <a class="btn btn--sm btn--wa" href={waProduct(p)} target="_blank" rel="noopener">Cotizar</a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="strip__bar wrap" aria-hidden="true"><i data-strip-progress></i></div>
    </div>
  </section>

  <!-- ================= 3 · CRISTAL ================= -->
  <section class="glass on-dark grain" aria-labelledby="glass-t" data-glass>
    <div class="glass__bg" aria-hidden="true"></div>
    <div class="wrap glass__grid">
      <div class="glass__copy">
        <p class="kicker">Tecnología de mostrador</p>
        <h2 id="glass-t">Audio y energía que se ven tan bien como funcionan.</h2>
        <p class="lede">Elige un producto y mira su ficha del catálogo.</p>
        <div class="glass__tabs" role="tablist" aria-label="Productos de tecnología">
          {glass.map((p, i) => (
            <button class="glass__tab" role="tab" type="button" id={`gt-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`gp-${i}`} data-gtab={i}>
              <span>{p.name}</span><small>{cop(p.price!)} COP</small>
            </button>
          ))}
        </div>
      </div>
      <div class="glass__stage" data-gstage>
        <div class="shards" aria-hidden="true">
          <span class="shard s1"></span><span class="shard s2"></span><span class="shard s3"></span><span class="shard s4"></span><span class="shard s5"></span>
          <span class="glint" data-glint></span>
        </div>
        {glass.map((p, i) => (
          <article class="gprod" role="tabpanel" id={`gp-${i}`} aria-labelledby={`gt-${i}`} data-gprod={i} hidden={i !== 0}>
            <Image class="gprod__img" src={productImage(p.images[0].file)} alt={p.name} widths={[420, 640]} sizes="(max-width: 800px) 70vw, 380px" loading="lazy" />
            <div class="gprod__card" data-reveal-glint>
              <p class="gprod__tag">{glassCopy[p.slug]}</p>
              <h3>{p.name}</h3>
              <p class="price"><span>{cop(p.price!)}</span><small>COP</small></p>
              <div class="gprod__actions">
                <a class="btn btn--sm" href={`/${p.slug}`}>Ver ficha</a>
                <a class="btn btn--sm btn--ghost" href={waProduct(p)} target="_blank" rel="noopener">Cotizar</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 4 · MANOS ================= -->
  <section class="handsec on-light" aria-labelledby="hands-t" data-handsec>
    <div class="handsec__rings" aria-hidden="true"></div>
    <div class="wrap">
      <p class="kicker kicker--c">Tecnología · reparación · negocio</p>
      <h2 id="hands-t" class="sr-only">Tecnología para quienes conectan y hacen crecer sus negocios</h2>
    </div>
    <div class="handsec__stack">
      <p class="handsec__l1" aria-hidden="true">Tecnología para quienes conectan</p>
      <div class="handsec__scene" data-hands-scene><Hands /></div>
      <p class="handsec__l2" aria-hidden="true">y hacen crecer sus negocios</p>
    </div>
    <div class="wrap">
      <ul class="handsec__cols">
        <li data-reveal><h3>Servicios técnicos</h3><p>Máquinas de corte, laminación con bomba de vacío y baterías de reemplazo para iPhone.</p></li>
        <li data-reveal style="--i:1"><h3>Tiendas de accesorios</h3><p>Suma la instalación de hidrogel a tu mostrador y complementa con cargadores, cables y vidrios.</p></li>
        <li data-reveal style="--i:2"><h3>Comercios y distribuidores</h3><p>Hidrogel por paquetes y accesorios para reponer inventario.</p></li>
      </ul>
    </div>
  </section>

  <!-- ================= 5 · CATEGORÍAS ================= -->
  <section class="cats on-dark" aria-labelledby="cats-t">
    <div class="wrap">
      <header class="cats__head">
        <div>
          <p class="kicker">Catálogo 2026</p>
          <h2 id="cats-t">Dos líneas, un mismo estándar.</h2>
        </div>
        <div class="cats__guide" aria-hidden="true"><PcHead pose="point" /></div>
      </header>
      <div class="cats__grid">
        <a class="cat cat--con" href="/conectividad" data-reveal>
          <svg class="cat__lines" viewBox="0 0 600 400" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
            <path class="cl" d="M-20 90 H180 L220 130 H420 L460 90 H620" /><path class="cl" d="M-20 200 H120 L170 250 H300 L340 210 H620" /><path class="cl" d="M-20 310 H240 L280 350 H620" />
            <circle cx="180" cy="90" r="5" /><circle cx="420" cy="130" r="5" /><circle cx="300" cy="250" r="5" /><circle cx="340" cy="210" r="5" />
          </svg>
          <div class="cat__imgs" aria-hidden="true">
            <Image class="ci ci--a" src={catImg('cargador-67w-tc-tc-gan-ultra-carga-rapida')} alt="" widths={[300, 460]} sizes="240px" loading="lazy" />
            <Image class="ci ci--b" src={catImg('power-bank-10-000-mah-22-5w-multipuerto')} alt="" widths={[300, 460]} sizes="220px" loading="lazy" />
            <Image class="ci ci--c" src={catImg('cable-60w-tc-tc-reforzado-1-5-m')} alt="" widths={[240, 360]} sizes="160px" loading="lazy" />
          </div>
          <div class="cat__body">
            <span class="cat__n">{nCon} entradas del catálogo</span>
            <h3>Conectividad</h3>
            <p>Cargadores, cables, power bank, audio, vidrios blindados, parlantes y baterías.</p>
            <span class="cat__go">Explorar conectividad <i aria-hidden="true">→</i></span>
          </div>
        </a>
        <a class="cat cat--hid" href="/hidrogel" data-reveal style="--i:1">
          <div class="cat__film" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="cat__imgs" aria-hidden="true">
            <Image class="ci ci--a" src={catImg('maquina-de-hidrogel-11-9-sellado-automatico-uv-oemp2300')} alt="" widths={[360, 560]} sizes="320px" loading="lazy" />
            <Image class="ci ci--b" src={catImg('hidrogel-mate')} alt="" widths={[260, 400]} sizes="170px" loading="lazy" />
            <Image class="ci ci--c" src={catImg('pen-hidrogel')} alt="" widths={[200, 300]} sizes="110px" loading="lazy" />
          </div>
          <div class="cat__body">
            <span class="cat__n">{nHid} entradas del catálogo</span>
            <h3>Hidrogel</h3>
            <p>Máquinas de corte libres de códigos, láminas en distintos acabados e insumos de instalación.</p>
            <span class="cat__go">Explorar hidrogel <i aria-hidden="true">→</i></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 6 · PARA TU NEGOCIO ================= -->
  <section class="biz on-light" aria-labelledby="biz-t">
    <div class="wrap biz__grid">
      <div class="biz__fig" aria-hidden="true"><PcHead pose="hold" /></div>
      <div class="biz__copy">
        <p class="kicker">Para tu negocio</p>
        <h2 id="biz-t">Arma tu lista y envíala en un solo mensaje.</h2>
        <ol class="biz__steps">
          <li data-reveal><b>1</b><div><h3>Arma tu lista</h3><p>Agrega productos desde el catálogo o desde cada ficha.</p></div></li>
          <li data-reveal style="--i:1"><b>2</b><div><h3>Envíala por WhatsApp</h3><p>Tu lista llega con cantidades y referencias en un solo mensaje.</p></div></li>
          <li data-reveal style="--i:2"><b>3</b><div><h3>Recibe la confirmación</h3><p>Un asesor te confirma precio final, disponibilidad y entrega.</p></div></li>
        </ol>
        <div class="biz__cta">
          <a class="btn btn--dark" href="/carrito">Abrir mi carrito</a>
          <a class="btn btn--line" href="/para-tu-negocio">Más sobre UBU para tu negocio</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 7 · COTIZACIÓN Y CIERRE ================= -->
  <section class="close on-dark grain" aria-labelledby="close-t">
    <div class="close__bg" aria-hidden="true"></div>
    <div class="close__face" aria-hidden="true"><UbuFace tone="blanco" /></div>
    <div class="wrap close__inner">
      <div class="close__card">
        <p class="kicker">Cotiza hoy</p>
        <h2 id="close-t">Cuéntanos qué necesitas y te respondemos por WhatsApp.</h2>
        <p class="lede">Precios de referencia del catálogo de septiembre de 2026. El precio final y la disponibilidad se confirman al cotizar.</p>
        <div class="close__actions">
          <a class="btn btn--wa" href={waGeneric} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
          <a class="btn btn--ghost" href={waAdvice} target="_blank" rel="noopener">Pedir asesoría</a>
          <a class="btn btn--ghost" href="/contacto">Otras formas de contacto</a>
        </div>
        <div class="close__seal"><Image src={seal} alt="" width={64} height={58} /><p><strong>365 días de garantía</strong><br />según el catálogo 2026 para cada referencia.</p></div>
      </div>
    </div>
  </section>

  <script>import '../scripts/home';</script>
</Base>

<style>
  /* ---------- 1 · HERO ---------- */
  .hero { position: relative; background: var(--tinta-0); }
  .hero__pin { position: relative; height: 100svh; min-height: 640px; overflow: hidden; isolation: isolate; }
  .hero__sky { position: absolute; inset: 0; background:
      radial-gradient(60% 55% at 74% 46%, rgba(65,185,193,.34), transparent 70%),
      radial-gradient(40% 40% at 12% 8%, rgba(64,91,165,.5), transparent 70%),
      linear-gradient(180deg, #06131E 0%, #0B2236 58%, #0F3446 100%); }
  .hero__floor { position: absolute; left: -20%; right: -20%; bottom: 0; height: 40%; transform-origin: 50% 100%; transform: perspective(500px) rotateX(58deg);
      background-image: linear-gradient(rgba(1,220,239,.35) 1px, transparent 1px), linear-gradient(90deg, rgba(1,220,239,.25) 1px, transparent 1px); background-size: 70px 70px; -webkit-mask-image: linear-gradient(to top, #000, transparent 85%); mask-image: linear-gradient(to top, #000, transparent 85%); opacity: .55; }
  .hero__road { position: absolute; left: 0; right: 0; bottom: 14%; height: 4px; display: flex; gap: 8vw; padding-left: 2vw; opacity: .75; }
  .hero__road i { flex: none; width: 9vw; height: 100%; background: rgba(255,255,255,.55); border-radius: 4px; animation: road 1.1s linear infinite; }
  @keyframes road { to { transform: translateX(-17vw); } }
  .hero__speed { position: absolute; inset: 0; pointer-events: none; }
  .hero__speed i { position: absolute; right: -10vw; height: 2px; width: 16vw; background: linear-gradient(90deg, transparent, rgba(255,255,255,.7)); opacity: 0; animation: speed 1.4s ease-out infinite; }
  .hero__speed i:nth-child(1) { top: 36%; animation-delay: .1s; } .hero__speed i:nth-child(2) { top: 44%; animation-delay: .5s; width: 22vw; } .hero__speed i:nth-child(3) { top: 52%; animation-delay: .9s; }
  .hero__speed i:nth-child(4) { top: 60%; animation-delay: .3s; width: 12vw; } .hero__speed i:nth-child(5) { top: 68%; animation-delay: .7s; }
  @keyframes speed { 0% { transform: translateX(0); opacity: 0; } 15% { opacity: .8; } 100% { transform: translateX(-120vw); opacity: 0; } }
  .hero.is-parked .hero__road i, .hero.is-parked .hero__speed i { animation-play-state: paused; opacity: 0; }
  .hero.is-parked .hero__road i { opacity: .6; }
  .hero__truck { position: absolute; right: 3vw; bottom: 17%; width: min(66vw, 980px); will-change: transform; z-index: 2; }
  .hero__particles { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .hero__face { position: absolute; right: clamp(40px, 14vw, 250px); top: 50%; width: min(32vw, 420px); transform: translateY(-50%) scale(.6); opacity: 0; z-index: 3; filter: drop-shadow(0 0 40px rgba(1,220,239,.45)); }
  .hero__copy { position: absolute; left: var(--gut); top: 50%; transform: translateY(-58%); width: min(46vw, 560px); z-index: 4; }
  .hero__copy h1, .hero__copy h2 { font-size: clamp(2.2rem, 4.6vw, 4.4rem); margin: 18px 0 20px; }
  .hero__copy--2 { opacity: 0; visibility: hidden; left: max(var(--gut), 6vw); top: 50%; bottom: auto; transform: translateY(-50%); width: min(40vw, 520px); }
  .hero__copy--2 h2 { font-size: clamp(2rem, 3.8vw, 3.7rem); margin: 14px 0 16px; }
  .hero__copy strong { color: var(--cian-realidad-virtual); font-weight: 600; }
  .hero__cta { position: absolute; left: var(--gut); bottom: clamp(22px, 5vh, 54px); z-index: 6; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .hero__skip { color: rgba(255,255,255,.7); font-size: .92rem; text-decoration: none; padding: .5em .8em; }
  .hero__skip:hover { color: #fff; }
  .hero__progress { position: absolute; right: var(--gut); bottom: 30px; width: 120px; height: 3px; background: rgba(255,255,255,.18); border-radius: 3px; z-index: 6; overflow: hidden; }
  .hero__progress i { display: block; height: 100%; width: 100%; background: var(--cian-realidad-virtual); transform-origin: left; transform: scaleX(0); }
  :global(.hero__particles i) { position: absolute; left: 0; top: 0; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%; background: var(--cian-realidad-virtual); box-shadow: 0 0 10px rgba(1,220,239,.8); opacity: 0; will-change: transform, opacity; }
  :global(.hero__particles i:nth-child(3n)) { background: var(--asombro-turmalina); }
  :global(.hero__particles i.is-eye) { background: #fff; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; }
  /* móvil / movimiento reducido: composición apilada sin pin */
  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    .hero__pin { height: auto; min-height: 100svh; display: flex; flex-direction: column; padding: 108px 0 36px; }
    .hero__copy, .hero__cta { position: relative; left: auto; top: auto; bottom: auto; transform: none; width: auto; padding: 0 var(--gut); }
    .hero__copy--1 { order: 1; } .hero__truck { order: 2; position: relative; right: auto; bottom: auto; width: 100%; margin: 18px 0 0; padding: 0 var(--gut); } .hero__cta { order: 3; margin-top: 18px; }
    .hero__copy--2 { order: 4; opacity: 1; visibility: visible; margin-top: 36px; } .hero__copy--2 h2 { font-size: 1.7rem; }
    .hero__face, .hero__particles, .hero__progress, .hero__skip { display: none; }
    .hero__copy h1 { font-size: clamp(2rem, 8.4vw, 3rem); }
    .hero__road { bottom: auto; top: 58%; } .hero__floor { height: 22%; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__road i, .hero__speed i { animation: none; } .hero__speed { display: none; } }
  .cta2 { display: none; }
  /* Escritorio: el mensaje final (rótulo, título, párrafo y botones) forma una sola columna alineada al contenedor de la página y
     centrada en vertical con la carita; sin posiciones absolutas por elemento (solo la capa de la escena). */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .hero__copy--2 {
      --cl: max(var(--gut), calc((100vw - var(--wrap)) / 2));
      left: 0; top: 0; bottom: 0; transform: none; width: calc(var(--cl) + min(40vw, 540px) + 2vw);
      padding: 0 0 5vh calc(var(--cl) + 2vw);
      display: flex; flex-direction: column; align-items: flex-start; justify-content: center;
    }
    .hero__copy--2 .kicker, .hero__copy--2 h2, .hero__copy--2 .lede { margin-left: 0; }
    .hero__copy--2 .lede { max-width: 34em; }
    .cta2 { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  }
  /* Móvil con movimiento: el camión se desintegra en partículas que forman la carita en su mismo lugar (sin fijar la página) */
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .hero__particles { display: block; }
    .hero__face { display: block; position: absolute; left: 0; top: 0; right: auto; width: min(50vw, 210px); transform: none; }
    :global(.hero__particles i) { width: 6px; height: 6px; margin: -3px 0 0 -3px; }
    :global(.hero__particles i.is-eye) { width: 8px; height: 8px; margin: -4px 0 0 -4px; }
  }

  /* ---------- 2 · DESTACADOS ---------- */
  .strip { position: relative; background: linear-gradient(180deg, #E9F7F8 0%, #D7EEF1 100%); overflow: hidden; }
  .strip__pin { position: relative; padding: 92px 0 34px; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; gap: 14px; }
  .strip__waves { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .strip__ghost { position: absolute; left: 0; right: 0; top: 46%; text-align: center; font-family: var(--font-display); font-weight: 800; font-size: clamp(5rem, 22vw, 20rem); line-height: .8; color: transparent; -webkit-text-stroke: 2px rgba(64,91,165,.14); white-space: nowrap; pointer-events: none; transform: translateY(-50%); }
  .strip__head { position: relative; display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px; }
  .strip__head h2 { font-size: clamp(1.7rem, 2.9vw, 2.6rem); max-width: 24ch; margin-top: 10px; }
  .strip__viewport { position: relative; perspective: 1200px; overflow: hidden; padding: 10px 0 4px; }
  .strip__track { display: flex; gap: clamp(20px, 3vw, 44px); list-style: none; margin: 0; padding: 0 var(--gut) 0 max(var(--gut), calc((100vw - var(--wrap)) / 2)); width: max-content; transform-style: preserve-3d; }
  .sitem { flex: none; width: clamp(230px, 22vw, 310px); transform-style: preserve-3d; will-change: transform; }
  .sitem__stage { position: relative; aspect-ratio: 1 / .92; display: grid; place-items: center; }
  .sitem__stage img { position: relative; z-index: 2; width: 88%; height: 88%; object-fit: contain; filter: drop-shadow(0 26px 24px rgba(10,26,41,.28)); }
  .sitem__stage img.is-blend { mix-blend-mode: multiply; filter: none; }
  .sitem__floor { position: absolute; left: 6%; right: 6%; bottom: 3%; height: 34px; border-radius: 50%; background: radial-gradient(closest-side, rgba(10,26,41,.34), transparent); }
  .sitem__info { text-align: center; display: grid; gap: 8px; justify-items: center; }
  .sitem__type { font-family: var(--font-display); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--confianza-indigo); font-weight: 600; }
  .sitem__info h3 { font-size: 1.12rem; line-height: 1.2; max-width: 22ch; }
  .sitem__info h3 a { text-decoration: none; }
  .sitem__info .price { font-size: 1.5rem; color: var(--tinta-1); }
  .sitem__actions { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .strip__bar { position: relative; height: 3px; background: rgba(15,36,54,.14); border-radius: 3px; overflow: hidden; }
  .strip__bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, var(--confianza-indigo), var(--cian-realidad-virtual)); transform-origin: left; transform: scaleX(.15); }
  /* movimiento reducido en escritorio: recorrido lateral nativo, sin transformaciones */
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .strip__pin { min-height: 0; }
    .strip__viewport { overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; perspective: none; scrollbar-width: none; }
    .strip__viewport::-webkit-scrollbar { display: none; }
    .strip__track { transform: none !important; }
    .sitem { scroll-snap-align: center; width: min(74vw, 320px); transform: none !important; }
    .strip__bar { display: none; }
  }
  /* móvil: los productos avanzan hacia abajo con el desplazamiento vertical normal (sin carrusel ni bloque fijado) */
  @media (max-width: 899px) {
    .strip__pin { min-height: 0; padding: 84px 0 56px; gap: 22px; }
    .strip__viewport { overflow: visible; scroll-snap-type: none; perspective: none; padding: 0; }
    .strip__track { display: grid; grid-template-columns: minmax(0, 1fr); width: auto; max-width: 440px; margin-inline: auto; gap: 40px; padding: 0 var(--gut); }
    /* palabra decorativa «CATÁLOGO» detrás de los productos: acompaña el recorrido y queda completa en pantalla */
    .strip { overflow: clip; } /* clip no crea contenedor de scroll: permite que la palabra se quede fija (sticky) mientras se baja */
    .strip__yr { display: none; }
    .strip__ghost { position: sticky; top: calc(50svh - 8vw); left: auto; right: auto; height: 16vw; margin: 0 0 calc(-16vw - 22px); z-index: 0; transform: none; font-size: 15.2vw; line-height: 16vw; text-transform: uppercase; text-align: center; -webkit-text-stroke: 1.5px rgba(64,91,165,.13); color: transparent; font-size: 16vw; }
    .sitem { width: auto; min-width: 0; scroll-snap-align: none; }
    .sitem__stage { aspect-ratio: 1 / 1; }
    .sitem__stage img { width: 84%; height: 84%; }
    .sitem__info { gap: 6px; }
    .sitem__info h3 { font-size: .98rem; max-width: none; }
    .sitem__info .price { font-size: 1.25rem; }
    .sitem__actions { width: 100%; }
    .sitem__actions .btn { flex: 1 1 0; min-width: 0; padding-inline: .6em; }
    .strip__bar { display: none; }
    .strip__head h2 { font-size: 1.6rem; }
  }
  /* móvil con movimiento: la sección se fija solo durante el recorrido y el scroll vertical mueve los productos de derecha a izquierda */
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    .strip { overflow: hidden; }
    .strip__pin { min-height: 100svh; padding: 78px 0 26px; gap: 14px; }
    .strip__viewport { overflow: hidden; padding: 6px 0 4px; }
    .strip__track { display: flex; width: max-content; max-width: none; margin-inline: 0; gap: 18px; padding: 0 var(--gut); }
    .sitem { width: min(64vw, 260px); flex: none; will-change: transform; }
    .sitem__stage img { width: 88%; height: 88%; }
    .sitem__actions { width: auto; }
    .sitem__actions .btn { flex: 0 0 auto; padding-inline: 1em; }
    .strip__ghost { position: absolute; left: 0; right: 0; top: 47%; height: auto; margin: 0; transform: translateY(-50%); line-height: .8; z-index: 0; }
    .strip__head, .strip__viewport, .strip__bar { z-index: 1; }
    .strip__bar { display: block; }
    .strip__head { gap: 12px; } .strip__head h2 { font-size: 1.4rem; margin-top: 6px; } .strip__head .btn { min-height: 44px; }
  }

  /* ---------- 3 · CRISTAL ---------- */
  .glass { position: relative; background: #040C14; overflow: hidden; padding: clamp(90px, 11vw, 150px) 0; }
  .glass__bg { position: absolute; inset: 0; background: radial-gradient(50% 60% at 78% 40%, rgba(64,91,165,.5), transparent 70%), radial-gradient(40% 50% at 20% 90%, rgba(1,220,239,.16), transparent 70%); }
  .glass__grid > * { min-width: 0; }
  .glass__grid { position: relative; z-index: 1; display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(24px, 5vw, 80px); align-items: center; }
  .glass__copy h2 { font-size: clamp(2rem, 4vw, 3.6rem); margin: 16px 0 18px; }
  .glass__tabs { display: grid; gap: 10px; margin-top: 30px; }
  .glass__tab { all: unset; box-sizing: border-box; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 14px; padding: 16px 20px; border-radius: var(--r-md); border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); transition: background-color .3s, border-color .3s, transform .35s var(--ease); font-family: var(--font-display); font-weight: 600; }
  .glass__tab { flex-wrap: wrap; }
  .glass__tab small { font-family: var(--font-body); opacity: .75; white-space: nowrap; }
  .glass__tab:hover { transform: translateX(6px); background: rgba(255,255,255,.09); }
  .glass__tab:focus-visible { outline: 3px solid var(--cian-realidad-virtual); outline-offset: 3px; }
  .glass__tab[aria-selected="true"] { border-color: var(--cian-realidad-virtual); background: rgba(1,220,239,.1); }
  .glass__stage { position: relative; aspect-ratio: 1.08 / 1; min-height: 360px; perspective: 1400px; }
  .glass__stage::before { content: ''; position: absolute; inset: 8% 6%; border-radius: 50%; background: radial-gradient(closest-side, rgba(1,220,239,.4), rgba(64,91,165,.25) 55%, transparent 75%); filter: blur(30px); }
  .shards { position: absolute; inset: 0; transform-style: preserve-3d; }
  .shard { position: absolute; background: linear-gradient(135deg, rgba(255,255,255,.3), rgba(255,255,255,.07) 45%, rgba(1,220,239,.2)); border: 1px solid rgba(255,255,255,.4);
      -webkit-backdrop-filter: blur(14px) saturate(1.5); backdrop-filter: blur(14px) saturate(1.5); box-shadow: inset 0 1px 0 rgba(255,255,255,.55), inset 0 -20px 40px rgba(64,91,165,.2), 0 30px 60px -30px rgba(0,0,0,.8); will-change: transform; }
  .s1 { --n: 0; left: 2%; top: 4%; width: 46%; height: 52%; clip-path: polygon(0 6%, 92% 0, 100% 78%, 14% 100%); border-radius: 24px; }
  .s2 { --n: 1; left: 44%; top: 0; width: 54%; height: 44%; clip-path: polygon(6% 0, 100% 10%, 90% 100%, 0 82%); border-radius: 24px; }
  .s3 { --n: 2; left: 0; top: 50%; width: 52%; height: 48%; clip-path: polygon(8% 14%, 100% 0, 88% 100%, 0 90%); border-radius: 24px; }
  .s4 { --n: 3; left: 46%; top: 40%; width: 52%; height: 58%; clip-path: polygon(0 0, 100% 16%, 94% 100%, 10% 86%); border-radius: 24px; }
  .s5 { --n: 4; left: 34%; top: 30%; width: 30%; height: 40%; clip-path: polygon(50% 0, 100% 40%, 80% 100%, 10% 90%, 0 30%); background: linear-gradient(135deg, rgba(1,220,239,.28), rgba(64,91,165,.1)); }
  .glint { display: none; }
  .shard::after { content: ""; position: absolute; inset: -2px; background: linear-gradient(105deg, transparent 32%, rgba(255,255,255,.62) 50%, transparent 68%); transform: translateX(-130%); opacity: 0; pointer-events: none; }
  .glass.is-lit .shard::after { animation: shine 7.5s cubic-bezier(.22,1,.36,1) infinite; animation-delay: calc(var(--n, 0) * .22s); }
  @keyframes shine { 0% { transform: translateX(-130%); opacity: 1; } 22% { transform: translateX(130%); opacity: 1; } 22.1%, 100% { transform: translateX(130%); opacity: 0; } }
  .gprod { position: absolute; inset: 0; display: grid; place-items: center; }
  .gprod[hidden] { display: none; }
  .gprod__img { position: relative; z-index: 3; width: min(64%, 360px); height: auto; max-height: 74%; object-fit: contain; filter: drop-shadow(0 30px 40px rgba(0,0,0,.55)); animation: gfloat 6s ease-in-out infinite; }
  @keyframes gfloat { 50% { transform: translateY(-10px); } }
  .gprod__card { position: absolute; z-index: 4; right: 0; bottom: 2%; width: min(62%, 320px); padding: 18px 20px; border-radius: var(--r-md); background: rgba(6,19,30,.72); border: 1px solid rgba(255,255,255,.2); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); display: grid; gap: 8px;
      -webkit-mask-image: linear-gradient(105deg, #000 0 var(--reveal, 100%), rgba(0,0,0,.0) calc(var(--reveal, 100%) + 18%)); mask-image: linear-gradient(105deg, #000 0 var(--reveal, 100%), rgba(0,0,0,.0) calc(var(--reveal, 100%) + 18%)); }
  .gprod__tag { font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: var(--cian-realidad-virtual); font-family: var(--font-display); font-weight: 600; }
  .gprod__card h3 { font-size: 1.15rem; line-height: 1.2; }
  .gprod__card .price { font-size: 1.7rem; }
  .gprod__actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  @media (max-width: 899px) {
    .glass__grid { grid-template-columns: 1fr; }
    .glass__stage { aspect-ratio: auto; min-height: 0; padding-top: 6px; }
    .glass__stage::before { inset: 0 8% auto; height: 300px; }
    .shards { inset: 0 0 auto 0; height: 300px; }
    .shard { -webkit-backdrop-filter: none; backdrop-filter: none; background: linear-gradient(135deg, rgba(255,255,255,.14), rgba(255,255,255,.03)); }
    .gprod { position: relative; inset: auto; display: grid; grid-template-rows: 300px auto; gap: 14px; justify-items: center; }
    .gprod__img { width: auto; height: auto; max-width: 74%; max-height: 270px; align-self: center; object-fit: contain; }
    .gprod__card { position: relative; right: auto; bottom: auto; width: 100%; max-width: 420px; margin: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .glass.is-lit .shard::after { animation: none; } .gprod__img { animation: none; } }

  /* ---------- 4 · MANOS ---------- */
  .handsec { position: relative; padding: clamp(64px, 8vw, 110px) 0 clamp(56px, 7vw, 96px); background: linear-gradient(180deg, #FFFFFF 0%, #EAF6F7 100%); overflow: hidden; text-align: center; }
  .handsec__rings { position: absolute; left: 50%; top: 50%; width: min(120vw, 1100px); aspect-ratio: 1; transform: translate(-50%, -52%); border-radius: 50%; background: radial-gradient(closest-side, rgba(1,220,239,.16), rgba(66,147,208,.1) 55%, transparent 72%); pointer-events: none; }
  .handsec__stack { position: relative; z-index: 1; margin-top: 10px; }
  .handsec__l1, .handsec__l2 { font-family: var(--font-display); font-weight: 700; letter-spacing: -.02em; line-height: 1.08; font-size: clamp(1.7rem, 3.8vw, 3.3rem); padding: 0 var(--gut); text-wrap: balance; max-width: 22ch; margin-inline: auto; }
  .handsec__l2 { color: var(--confianza-indigo); }
  .handsec__scene { width: min(100%, 760px); margin: clamp(-6px, 1vw, 14px) auto; pointer-events: none; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%); mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%); }
  .handsec__scene :global(.hands) { width: 100%; }
  .handsec__cols { position: relative; z-index: 3; margin: clamp(30px, 4vw, 56px) auto 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 3vw, 36px); text-align: left; }
  .handsec__cols li { padding: 22px 24px; border-radius: var(--r-md); background: rgba(255,255,255,.7); border: 1px solid var(--linea); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .handsec__cols h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .handsec__cols p { font-size: .98rem; color: var(--texto-suave); }
  @media (max-width: 760px) { .handsec__cols { grid-template-columns: 1fr; } }

  /* ---------- 5 · CATEGORÍAS ---------- */
  .cats { position: relative; padding: clamp(80px, 10vw, 140px) 0; background: radial-gradient(60% 60% at 15% 0%, rgba(64,91,165,.35), transparent 70%), var(--tinta-1); overflow: hidden; }
  .cats__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: clamp(24px, 3vw, 40px); }
  .cats__head h2 { font-size: clamp(2rem, 4vw, 3.6rem); margin-top: 14px; }
  .cats__guide { width: clamp(110px, 16vw, 200px); margin: 0 clamp(48px, 11vw, 190px) -14px 0; flex: none; line-height: 0; }
  .cats__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(16px, 2.4vw, 28px); }
  .cat { position: relative; display: flex; flex-direction: column; justify-content: flex-end; min-height: clamp(420px, 46vw, 560px); padding: clamp(22px, 3vw, 38px); border-radius: var(--r-lg); overflow: hidden; text-decoration: none; isolation: isolate; transition: transform .6s var(--ease), box-shadow .6s var(--ease); }
  .cat:hover, .cat:focus-visible { transform: translateY(-8px); box-shadow: 0 40px 80px -40px rgba(1,220,239,.5); }
  .cat--con { background: linear-gradient(160deg, #0B2236, #05101B 70%); border: 1px solid rgba(1,220,239,.28); color: #fff; }
  .cat--hid { background: linear-gradient(160deg, #F4FDFE, #BEE9EE 60%, #8FD4DC); color: var(--tinta-1); }
  .cat__lines { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .cat__lines .cl { fill: none; stroke: rgba(1,220,239,.45); stroke-width: 2; stroke-dasharray: 10 14; animation: flow 3s linear infinite; }
  .cat__lines circle { fill: var(--cian-realidad-virtual); }
  @keyframes flow { to { stroke-dashoffset: -48; } }
  .cat__film { position: absolute; inset: 0; z-index: -1; }
  .cat__film i { position: absolute; border-radius: 28px; border: 1.5px solid rgba(255,255,255,.7); background: linear-gradient(135deg, rgba(255,255,255,.55), rgba(255,255,255,.08)); box-shadow: 0 30px 50px -30px rgba(10,26,41,.4); transition: transform .8s var(--ease); }
  .cat__film i:nth-child(1) { width: 62%; height: 52%; right: -6%; top: 8%; transform: rotate(8deg); }
  .cat__film i:nth-child(2) { width: 56%; height: 48%; right: 4%; top: 14%; transform: rotate(-4deg); }
  .cat__film i:nth-child(3) { width: 50%; height: 44%; right: 12%; top: 20%; transform: rotate(-14deg); }
  .cat--hid:hover .cat__film i:nth-child(1) { transform: rotate(14deg) translate(14px, -8px); } .cat--hid:hover .cat__film i:nth-child(3) { transform: rotate(-22deg) translate(-12px, 8px); }
  .cat__imgs { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .ci { position: absolute; height: auto; object-fit: contain; filter: drop-shadow(0 24px 24px rgba(0,0,0,.4)); transition: transform .7s var(--ease); }
  .cat--con .ci--a { width: 46%; right: 8%; top: 8%; } .cat--con .ci--b { width: 38%; right: 40%; top: 26%; } .cat--con .ci--c { width: 26%; right: 4%; top: 46%; }
  .cat--hid .ci--a { width: 70%; right: 6%; top: 10%; } .cat--hid .ci--b { width: 30%; right: 52%; top: 34%; } .cat--hid .ci--c { width: 14%; right: 6%; top: 42%; }
  .cat:hover .ci--a { transform: translateY(-12px) rotate(-2deg); } .cat:hover .ci--b { transform: translateY(-6px) rotate(3deg); } .cat:hover .ci--c { transform: translateY(-16px) rotate(8deg); }
  .cat__body { position: relative; z-index: 2; display: grid; gap: 10px; max-width: 34ch; padding: 20px 22px; border-radius: var(--r-md); background: rgba(5,16,27,.55); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,.14); color: #fff; }
  .cat--hid .cat__body { background: rgba(255,255,255,.72); border-color: rgba(255,255,255,.9); color: var(--tinta-1); }
  .cat__n { font-family: var(--font-display); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; opacity: .8; font-weight: 600; }
  .cat h3 { font-size: clamp(1.9rem, 3vw, 2.8rem); }
  .cat__go { display: inline-flex; gap: .5em; font-family: var(--font-display); font-weight: 600; color: var(--cian-realidad-virtual); }
  .cat--hid .cat__go { color: var(--confianza-indigo); }
  .cat__go i { font-style: normal; transition: transform .35s var(--ease); } .cat:hover .cat__go i { transform: translateX(8px); }
  @media (max-width: 899px) {
    .cats__grid { grid-template-columns: 1fr; }
    .cats__guide { width: 96px; margin: 0 8px -12px 0; }
    .cat { min-height: 0; padding: 0; justify-content: flex-start; }
    .cat__imgs { position: relative; inset: auto; flex: none; height: clamp(230px, 64vw, 300px); }
    .cat .ci { width: auto; max-width: none; height: auto; }
    .cat--con .ci--a { height: 82%; left: 33%; right: auto; top: 6%; }
    .cat--con .ci--b { height: 62%; left: 5%; right: auto; top: auto; bottom: 8%; }
    .cat--con .ci--c { height: 70%; left: auto; right: 5%; top: auto; bottom: 8%; }
    .cat--hid .ci--a { height: 66%; left: 2%; right: auto; top: 10%; }
    .cat--hid .ci--b { height: 74%; left: 48%; right: auto; top: auto; bottom: 6%; }
    .cat--hid .ci--c { height: 70%; left: auto; right: 4%; top: auto; bottom: 6%; }
    .cat__body { margin: 0 14px 14px; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) { .cat__lines .cl { animation: none; } .cat, .ci, .cat__film i { transition: none; } }

  /* ---------- 6 · NEGOCIO ---------- */
  .biz { background: linear-gradient(180deg, #EAF6F7, #fff); padding: clamp(70px, 9vw, 130px) 0; overflow: hidden; }
  .biz__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(24px, 5vw, 80px); align-items: center; }
  .biz__fig { width: min(100%, 440px); margin-inline: auto; position: relative; }
  .biz__fig::before { content: ''; position: absolute; inset: 12% -6% -2%; border-radius: 40% 60% 50% 50%; background: linear-gradient(160deg, rgba(1,220,239,.28), rgba(64,91,165,.14)); z-index: 0; }
  .biz__fig :global(.pchead) { position: relative; z-index: 1; }
  .biz__copy h2 { font-size: clamp(1.9rem, 3.6vw, 3.2rem); margin: 14px 0 26px; max-width: 18ch; }
  .biz__steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .biz__steps li { display: grid; grid-template-columns: 52px 1fr; gap: 16px; align-items: start; padding: 16px 18px; background: #fff; border: 1px solid var(--linea); border-radius: var(--r-md); }
  .biz__steps b { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, var(--asombro-turmalina), var(--azul-silicon-valley)); color: #fff; font-family: var(--font-display); font-size: 1.3rem; }
  .biz__steps h3 { font-size: 1.1rem; } .biz__steps p { color: var(--texto-suave); font-size: .98rem; }
  .biz__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media (max-width: 860px) { .biz__grid { grid-template-columns: 1fr; } .biz__fig { max-width: 300px; } }

  /* ---------- 7 · CIERRE ---------- */
  .close { position: relative; padding: clamp(90px, 11vw, 160px) 0; background: var(--tinta-0); overflow: hidden; }
  .close__bg { position: absolute; inset: 0; background: radial-gradient(70% 90% at 80% 20%, rgba(65,185,193,.55), transparent 65%), radial-gradient(60% 80% at 10% 90%, rgba(64,91,165,.8), transparent 65%), linear-gradient(135deg, #0B2236, #0D3145); }
  .close__face { position: absolute; right: -4%; top: 50%; width: min(52vw, 640px); transform: translateY(-50%); opacity: .18; }
  .close__inner { position: relative; z-index: 1; }
  .close__card { max-width: 720px; padding: clamp(26px, 4vw, 52px); border-radius: var(--r-lg); background: linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.05)); border: 1px solid rgba(255,255,255,.28); -webkit-backdrop-filter: blur(20px) saturate(1.4); backdrop-filter: blur(20px) saturate(1.4); box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 40px 80px -40px rgba(0,0,0,.7); }
  .close__card h2 { font-size: clamp(2rem, 4vw, 3.5rem); margin: 14px 0 16px; }
