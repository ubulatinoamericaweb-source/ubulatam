---
import Base from '../layouts/Base.astro';
import PcHead from '../components/PcHead.astro';
import UbuFace from '../components/UbuFace.astro';
import { products, WA_NUMBER, WA_DISPLAY } from '../data/catalog';
import { WA_PATH, PIN_PATH } from '../data/icons';
import { areas, allPeople, waLink, telLink } from '../data/contacts';
const options = products.filter((p) => !p.info).map((p) => p.name);
const saves = !!(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
const maps = 'https://www.google.com/maps/search/?api=1&query=Centro%20Empresarial%20Hayuelos';
const dest = allPeople.map((x) => ({ id: x.id, wa: x.wa, name: x.name, first: x.first, phone: x.phone, area: x.area }));
---
<Base title="Contacto y cotización" description="Contacta a UBU Latinoamérica por área: Gerencia, Ventas y Facturación y cartera. Llama o escribe por WhatsApp, o envía tu solicitud de cotización.">
  <section class="ct on-dark" aria-labelledby="ct-t">
    <div class="ct__bg" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <nav aria-label="Ruta de navegación"><ol class="crumbs"><li><a href="/">Inicio</a></li><li aria-current="page">Contacto</li></ol></nav>
      <div class="ct__head">
        <div>
          <p class="kicker">Contacto</p>
          <h1 id="ct-t">Hablemos de tu pedido.</h1>
          <p class="lede">Escoge el área con la que quieres hablar: puedes llamar o escribirle directo por WhatsApp.</p>
        </div>
        <div class="ct__fig" aria-hidden="true"><PcHead pose="wave" /></div>
      </div>

      <div class="areas">
        {areas.map((a, i) => (
          <section class={`area area--${a.id}`} aria-labelledby={`area-${a.id}`} data-reveal style={`--i:${i}`}>
            <header><h2 id={`area-${a.id}`}>{a.name}</h2><p>{a.hint}</p></header>
            <ul>
              {a.people.map((x) => (
                <li class="person">
                  <div class="person__id"><span class="person__av" aria-hidden="true">{x.first[0]}</span><div><b>{x.name}</b><a class="person__tel" href={telLink(x)} aria-label={`Llamar a ${x.name} al ${x.phone}`}>{x.phone}</a></div></div>
                  <div class="person__act">
                    <a class="btn btn--wa btn--sm" href={waLink(x)} target="_blank" rel="noopener" aria-label={`Escribir por WhatsApp a ${x.name}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={WA_PATH} fill="currentColor" /></svg>WhatsApp</a>
                    <a class="btn btn--ghost btn--sm" href={telLink(x)} aria-label={`Llamar a ${x.name}`}>Llamar</a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <a class="place" href={maps} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={PIN_PATH} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span><small>Punto de atención</small><b>Centro Empresarial Hayuelos</b></span><i aria-hidden="true">Ver ubicación →</i>
      </a>

      <div class="ct__main" id="cotizar">
        <form class="form ct__form" id="cform" novalidate data-wa={WA_NUMBER} data-saves={saves ? '1' : '0'}>
          <h2 class="h2" style="margin:0;font-size:1.7rem">Solicita tu cotización</h2>
          <p>Completa lo esencial y continúa en WhatsApp con tu mensaje listo.</p>
          <div class="field"><label for="f-to">¿A quién quieres escribir?</label>
            <select id="f-to" name="destino">
              <option value="">Línea general de WhatsApp ({WA_DISPLAY})</option>
              {areas.map((a) => <optgroup label={a.name}>{a.people.map((x) => <option value={x.id}>{x.name} · {x.phone}</option>)}</optgroup>)}
            </select></div>
          <div class="field"><label for="f-name">Nombre</label><input id="f-name" name="nombre" autocomplete="name" required maxlength="80" /><span class="err" id="e-name" aria-live="polite"></span></div>
          <div class="ct__two">
            <div class="field"><label for="f-city">Ciudad (opcional)</label><input id="f-city" name="ciudad" autocomplete="address-level2" maxlength="60" /></div>
            <div class="field"><label for="f-type">Tipo de cliente (opcional)</label>
              <select id="f-type" name="tipo"><option value="">Selecciona</option><option>Tienda de accesorios</option><option>Servicio técnico</option><option>Distribuidor</option><option>Cliente final</option><option>Otro</option></select></div>
          </div>
          <div class="field"><label for="f-prod">Producto de interés (opcional)</label>
            <select id="f-prod" name="producto"><option value="">Selecciona</option>{options.map((o) => <option>{o}</option>)}<option>Otro producto del catálogo</option></select></div>
          <div class="field"><label for="f-msg">Mensaje (opcional)</label><textarea id="f-msg" name="mensaje" maxlength="600"></textarea></div>
          <label class="check"><input type="checkbox" id="f-list" /> <span>Incluir los productos de mi carrito, si tengo alguno.</span></label>
          <label class="check"><input type="checkbox" id="f-consent" required /> <span>Autorizo a UBU Latinoamérica a tratar mis datos para responder esta solicitud, según la <a href="/privacidad">Política de tratamiento de datos</a>.</span></label>
          <span class="err" id="e-consent" aria-live="polite"></span>
          <label class="check"><input type="checkbox" id="f-mkt" /> <span>Quiero recibir información comercial y novedades de UBU por WhatsApp (opcional).</span></label>
          <button class="btn btn--wa" type="submit">Continuar en WhatsApp</button>
          <p style="font-size:.9rem;color:var(--texto-suave)">Se abrirá WhatsApp con tu mensaje para que lo envíes.{saves && ' Guardamos una copia de tu solicitud para darle seguimiento, según la política de datos.'}</p>
        </form>

        <div class="phone">
          <div class="phone__body">
            <div class="phone__bar"><span class="phone__av"><UbuFace tone="blanco" eyes={false} /></span><span><b id="pv-name">UBU Latinoamérica</b><small id="pv-phone">{WA_DISPLAY}</small></span></div>
            <div class="phone__chat">
              <p class="phone__label" id="pv-label">Vista previa de tu mensaje</p>
              <div class="bubble" id="pv" role="status" aria-live="off" aria-labelledby="pv-label">Hola UBU Latinoamérica, quiero cotizar.</div>
              <span class="phone__tick" aria-hidden="true">✓✓</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script type="application/json" id="dest-data" set:html={JSON.stringify(dest)} />
  <script>
    import { qGet } from '../scripts/core';
    import { products } from '../data/catalog';
    const f = document.getElementById('cform') as HTMLFormElement | null;
    if (f) {
      const byname = new Map(products.map((p) => [p.slug, p]));
      type D = { id: string; wa: string; name: string; first: string; phone: string; area: string };
      const dests: D[] = JSON.parse(document.getElementById('dest-data')!.textContent || '[]');
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement & HTMLSelectElement & HTMLTextAreaElement;
      const current = () => dests.find((d) => d.id === $('f-to').value);
      const intro = () => {
        const d = current();
        if (!d) return 'Hola UBU Latinoamérica, quiero cotizar.';
        if (d.area === 'Gerencia') return `Hola ${d.first}, me comunico desde la página web de UBU Latinoamérica.`;
        if (d.area === 'Facturación y cartera') return `Hola ${d.first}, tengo una consulta de facturación o cartera.`;
        return `Hola ${d.first}, quiero cotizar.`;
      };
      const build = () => {
        const name = $('f-name').value.trim();
        const lines = [intro()];
        if (name) lines.push(`Nombre: ${name}`);
        if ($('f-city').value.trim()) lines.push(`Ciudad: ${$('f-city').value.trim()}`);
        if ($('f-type').value) lines.push(`Tipo de cliente: ${$('f-type').value}`);
        if ($('f-prod').value) lines.push(`Producto de interés: ${$('f-prod').value}`);
        if ($('f-msg').value.trim()) lines.push(`Mensaje: ${$('f-msg').value.trim()}`);
        let listTxt = '';
        if ($('f-list').checked) {
          const items = qGet().map((i) => ({ p: byname.get(i.id), qty: i.qty, v: i.v })).filter((x) => x.p);
          if (items.length) { listTxt = items.map((x) => `• ${x.qty} x ${x.p!.name}${x.v ? ' (' + x.v + ')' : ''}`).join('\n'); lines.push('Mi carrito:\n' + listTxt); }
        }
        if ($('f-mkt').checked) lines.push('Acepto recibir información comercial por WhatsApp.');
        return { text: lines.join('\n'), name, listTxt };
      };
      const pv = document.getElementById('pv')!;
      const ph = document.getElementById('pv-phone')!; const defPhone = ph.textContent || '';
      const refresh = () => {
        pv.textContent = build().text;
        const d = current();
        document.getElementById('pv-name')!.textContent = d ? d.name : 'UBU Latinoamérica';
        ph.textContent = d ? d.phone : defPhone;
      };
      f.addEventListener('input', refresh); f.addEventListener('change', refresh); refresh();
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const { text, name, listTxt } = build();
        const consent = $('f-consent').checked;
        document.getElementById('e-name')!.textContent = name ? '' : 'Escribe tu nombre.';
        document.getElementById('e-consent')!.textContent = consent ? '' : 'Debes autorizar el tratamiento de tus datos para continuar.';
        if (!name || !consent) return;
        const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined, sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
        if (f.dataset.saves === '1' && sbUrl && sbKey) {
          fetch(`${sbUrl}/rest/v1/solicitudes`, { method: 'POST', keepalive: true, headers: { apikey: sbKey, Authorization: `Bearer ${sbKey}`, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
            body: JSON.stringify({ tipo: 'contacto', nombre: name, ciudad: $('f-city').value.trim() || null, tipo_cliente: $('f-type').value || null, productos: $('f-prod').value || listTxt || null, mensaje: $('f-msg').value.trim() || null, acepta_comercial: $('f-mkt').checked }) }).catch(() => {});
        }
        const number = current()?.wa || f.dataset.wa;
        window.open(`https://wa.me/${number}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
      });
    }
  </script>
</Base>

<style>
  .ct { position: relative; padding: calc(var(--header-h) + 50px) 0 clamp(70px, 8vw, 120px); overflow: hidden; isolation: isolate; background: linear-gradient(165deg, #0B2236, #05101B); }
  .ct__bg i { position: absolute; border-radius: 50%; filter: blur(70px); z-index: -1; } .ct__bg i:nth-child(1) { width: 50vw; aspect-ratio: 1; right: -10vw; top: -8vw; background: rgba(65,185,193,.4); } .ct__bg i:nth-child(2) { width: 40vw; aspect-ratio: 1; left: -12vw; bottom: 10%; background: rgba(64,91,165,.55); }
  .ct__head { display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: end; } .ct h1 { font-size: clamp(2.4rem, 6vw, 5rem); margin: 14px 0 16px; }
  .ct__fig { width: clamp(120px, 16vw, 210px); margin-bottom: -6px; }

  .areas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 30px 0 16px; align-items: stretch; }
  .area { display: flex; flex-direction: column; gap: 14px; padding: 22px; border-radius: var(--r-lg); background: linear-gradient(160deg, rgba(255,255,255,.12), rgba(255,255,255,.05)); border: 1px solid rgba(255,255,255,.2); box-shadow: 0 24px 44px -28px rgba(0,0,0,.7), inset 0 1px 0 rgba(255,255,255,.22); }
  .area--ventas { border-color: rgba(37,211,102,.55); }
  .area h2 { font-size: 1.5rem; } .area header p { font-size: .92rem; opacity: .78; margin-top: 2px; }
  .area ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .person { display: grid; gap: 12px; padding: 14px; border-radius: var(--r-md); background: rgba(5,16,27,.5); border: 1px solid rgba(255,255,255,.14); }
  .person__id { display: flex; align-items: center; gap: 12px; min-width: 0; } .person__id > div { display: grid; min-width: 0; }
  .person__av { width: 44px; height: 44px; flex: none; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, var(--asombro-turmalina), var(--azul-silicon-valley)); color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; }
  .person b { font-family: var(--font-display); font-size: 1.02rem; line-height: 1.2; }
  .person__tel { display: inline-flex; align-items: center; min-height: 44px; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--cian-realidad-virtual); text-decoration: none; white-space: nowrap; } .person__tel:hover { text-decoration: underline; }
  .person__act { display: flex; flex-wrap: wrap; gap: 8px; } .person__act .btn { flex: 1 1 120px; } .person__act svg { width: 18px; height: 18px; }
  .place { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; min-height: 76px; padding: 14px 22px; margin-bottom: clamp(30px, 4vw, 54px); border-radius: var(--r-lg); text-decoration: none; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.22); transition: transform .35s var(--ease), border-color .25s, background-color .25s; }
  .place:hover, .place:focus-visible { transform: translateY(-3px); border-color: var(--cian-realidad-virtual); background: rgba(1,220,239,.12); }
  .place svg { width: 30px; height: 30px; } .place span { display: grid; gap: 2px; } .place small { opacity: .75; } .place b { font-family: var(--font-display); font-size: 1.2rem; } .place i { font-style: normal; font-family: var(--font-display); font-weight: 700; }

  .ct__main { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(20px, 4vw, 60px); align-items: start; scroll-margin-top: 90px; }
  .ct__form { padding: clamp(20px, 3vw, 36px); border-radius: var(--r-lg); background: #fff; color: var(--texto); box-shadow: 0 40px 80px -40px rgba(0,0,0,.7); } .ct__form p { color: var(--texto-suave); }
  .ct__two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .phone { position: sticky; top: 96px; width: min(100%, 360px); margin-inline: auto; padding: 12px; border-radius: 44px; background: linear-gradient(160deg, #26313b, #0b0f14); box-shadow: 0 40px 70px -30px rgba(0,0,0,.8), inset 0 0 0 2px rgba(255,255,255,.12); transform: rotate(2.5deg); }
  .phone__body { border-radius: 34px; overflow: hidden; background: #E7E3DC; min-height: 480px; display: grid; grid-template-rows: auto 1fr; }
  .phone__bar { display: flex; align-items: center; gap: 12px; padding: 16px 18px; background: #075E54; color: #fff; } .phone__bar span:last-child { display: grid; } .phone__bar small { opacity: .8; font-size: .78rem; }
  .phone__av { width: 40px; height: 40px; padding: 8px; border-radius: 50%; background: var(--gris-guernica); }
  .phone__chat { padding: 18px 14px; display: grid; align-content: start; gap: 6px; background-image: radial-gradient(rgba(0,0,0,.05) 1px, transparent 1px); background-size: 14px 14px; }
  .phone__label { font-size: .76rem; text-align: center; color: #5b6770; background: rgba(255,255,255,.7); border-radius: 10px; padding: .35em .8em; justify-self: center; }
  .bubble { justify-self: end; max-width: 92%; white-space: pre-wrap; word-break: break-word; padding: 10px 14px; border-radius: 14px 14px 4px 14px; background: #DCF8C6; color: #14222E; font-size: .95rem; line-height: 1.4; box-shadow: 0 1px 2px rgba(0,0,0,.2); }
  .phone__tick { justify-self: end; font-size: .78rem; color: #4FC3F7; }
  @media (max-width: 1000px) { .areas { grid-template-columns: 1fr 1fr; } .area--cartera { grid-column: 1 / -1; } }
  @media (max-width: 900px) { .ct__main { grid-template-columns: 1fr; } .phone { position: static; transform: none; } .ct__head { grid-template-columns: 1fr; } .ct__fig { display: none; } .ct__two { grid-template-columns: 1fr; } }
  @media (max-width: 680px) { .areas { grid-template-columns: 1fr; } .place { grid-template-columns: auto 1fr; } .place i { display: none; } }
</style>
