---
import Base from '../layouts/Base.astro';
import InnerHero from '../components/InnerHero.astro';
import { Image } from 'astro:assets';
import { categories, byCategory, priceLabel, bySlug, productImage } from '../data/catalog';
const shots: Record<string, string[]> = { conectividad: ['cargador-pd-45w-gan-super-carga-rapida-tc-tc', 'power-bank-10-000-mah-22-5w-multipuerto', 'audifonos-oseos-con-pantalla'], hidrogel: ['maquina-de-hidrogel-21-pulgadas', 'hidrogel-mate', 'pala-grande'] };
const pimg = (s: string) => productImage(bySlug(s)!.images[0].file);
const cats = (['conectividad', 'hidrogel'] as const).map((c) => ({ ...categories[c], list: byCategory(c) }));
---
<Base title="Catálogo 2026 con precios en COP" description="Lista completa del catálogo UBU Latinoamérica 2026, en el orden del catálogo: Conectividad e Hidrogel, con precios de referencia en pesos colombianos (COP).">
  <InnerHero kicker="Catálogo 2026" title="Todo el catálogo, en el orden del catálogo." lede="Precios de referencia en pesos colombianos (COP). Se confirman al cotizar." crumbs={[{ label: 'Catálogo' }]}>
    <p style="margin-top:26px;display:flex;flex-wrap:wrap;gap:12px">
      <a class="btn" href="/conectividad">Ver Conectividad</a><a class="btn" href="/hidrogel">Ver Hidrogel</a>
      <a class="btn btn--ghost" href="/descargas/catalogo-ubu-2026.pdf" download>Descargar catálogo PDF</a>
    </p>
  </InnerHero>
  <section class="pick" aria-label="Elegir línea">
    <div class="wrap pick__grid">
      {cats.map((c, k) => (
        <a class={`pk pk--${c.slug}`} href={`/${c.slug}`} data-reveal style={`--i:${k}`}>
          <span class="pk__imgs" aria-hidden="true">{shots[c.slug].map((s, i) => <Image class={`pi pi--${i}`} src={pimg(s)} alt="" widths={[200, 320]} sizes="150px" loading="lazy" />)}</span>
          <span class="pk__body"><b>{c.name}</b><span>{c.short}</span><em>{c.list.length} entradas · Ver con fotos →</em></span>
        </a>
      ))}
    </div>
  </section>
  {cats.map((c, k) => (
    <section class={`band ${k ? 'band--white' : 'band--light'}`} aria-labelledby={`l-${c.slug}`}>
      <div class="wrap">
        <p class="kicker">{c.short}</p>
        <h2 class="h2" id={`l-${c.slug}`}>{c.name} · {c.list.length} entradas</h2>
        <div class="tbl" tabindex="0" role="region" aria-label={`Lista de precios de ${c.name}`}>
          <table>
            <thead><tr><th scope="col">#</th><th scope="col">Producto</th><th scope="col">Tipo</th><th scope="col" class="num">Precio de referencia</th><th scope="col">Pág.</th></tr></thead>
            <tbody>
              {c.list.map((p, i) => (
                <tr>
                  <td class="t-n">{i + 1}</td>
                  <th scope="row">{p.info ? p.name : <a href={`/${p.slug}`}>{p.name}</a>}</th>
                  <td class="t-type">{p.type}</td>
                  <td class="num">{p.price == null ? <small>Sin precio en el catálogo</small> : <>{priceLabel(p)} <small>COP</small></>}</td>
                  <td class="t-page">{p.page}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="margin-top:18px"><a class="btn btn--dark" href={`/${c.slug}`}>Ver {c.name} con fotos y fichas</a></p>
      </div>
    </section>
  ))}
</Base>
<style>
  .pick { position: relative; z-index: 2; margin-top: -54px; }
  .pick__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pk { position: relative; display: block; min-height: 250px; border-radius: var(--r-lg); overflow: hidden; text-decoration: none; isolation: isolate; border: 1px solid rgba(255,255,255,.2); box-shadow: 0 40px 70px -40px rgba(5,16,27,.7); transition: transform .5s var(--ease); }
  .pk:hover { transform: translateY(-6px); } .pk--conectividad { background: linear-gradient(150deg, #1F2F66, #0A1530); color: #fff; } .pk--hidrogel { background: linear-gradient(150deg, #F7FEFF, #8FD4DC); color: var(--tinta-1); }
  .pk__imgs { position: absolute; right: 2%; top: 8%; width: 58%; height: 84%; } .pi { position: absolute; height: auto; filter: drop-shadow(0 16px 16px rgba(0,0,0,.4)); transition: transform .6s var(--ease); }
  .pi--0 { width: 56%; right: 24%; top: 4%; } .pi--1 { width: 38%; right: 0; top: 30%; } .pi--2 { width: 30%; right: 52%; bottom: 0; } .pk:hover .pi--0 { transform: translateY(-8px) rotate(-2deg); } .pk:hover .pi--1 { transform: translateY(-5px) rotate(3deg); }
  .pk__body { position: absolute; left: 22px; bottom: 20px; display: grid; gap: 4px; max-width: 46%; } .pk__body b { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.2rem); } .pk__body span { font-size: .95rem; opacity: .85; } .pk__body em { font-style: normal; font-family: var(--font-display); font-weight: 700; color: var(--cian-realidad-virtual); } .pk--hidrogel .pk__body em { color: var(--confianza-indigo); }
  @media (max-width: 760px) {
    .pick__grid { grid-template-columns: 1fr; }
    /* imágenes arriba (completas dentro de su caja) y texto debajo: nada se corta ni se amontona */
    .pk { min-height: 0; display: flex; flex-direction: column; }
    .pk__imgs { position: relative; right: auto; top: auto; width: 100%; height: 190px; flex: none; }
    .pi { max-width: none; object-fit: contain; }
    .pi--0 { width: 40%; height: 84%; left: 30%; right: auto; top: 8%; } .pi--1 { width: 30%; height: 66%; right: 6%; left: auto; top: auto; bottom: 8%; } .pi--2 { width: 26%; height: 58%; left: 6%; right: auto; top: auto; bottom: 6%; }
    .pk__body { position: static; max-width: none; padding: 6px 18px 18px; }
  }
  .tbl { overflow: auto; border-radius: var(--r-md); border: 1px solid var(--linea); background: #fff; color: var(--texto); }
  table { width: 100%; border-collapse: collapse; min-width: 640px; } th, td { padding: .75em 1em; text-align: left; border-bottom: 1px solid var(--linea); }
  thead th { background: var(--tinta-1); color: #fff; font-family: var(--font-display); font-size: .76rem; letter-spacing: .1em; text-transform: uppercase; }
  tbody th { font-family: var(--font-display); font-weight: 600; } tbody th a { text-decoration: none; } tbody th a:hover { color: var(--confianza-indigo); text-decoration: underline; }
  .num { text-align: right; font-family: var(--font-display); font-weight: 700; white-space: nowrap; } .num small { opacity: .6; font-weight: 600; }
  tbody tr:hover { background: var(--bruma); }
  /* móvil: cada producto es una tarjeta compacta con TODOS sus datos (número, nombre, tipo, página y precio), sin desplazamiento horizontal */
  @media (max-width: 720px) {
    .tbl { overflow: visible; border: 0; background: transparent; border-radius: 0; }
    table { min-width: 0; }
    table, tbody, tr, th, td { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    tbody { display: grid; gap: 10px; }
    tbody tr { display: grid; grid-template-columns: 34px auto minmax(0, 1fr); grid-template-areas: "n name name" "n type page" "n price price"; gap: 2px 10px; align-items: center; padding: 12px 14px 12px 12px; border-radius: var(--r-md); background: #fff; border: 1px solid var(--linea); box-shadow: 0 12px 24px -22px rgba(5,16,27,.5); }
    tbody tr:hover { background: #fff; }
    tbody th, tbody td { padding: 0; border: 0; }
    .t-n { grid-area: n; align-self: start; width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: var(--bruma); color: var(--confianza-indigo); font-family: var(--font-display); font-weight: 700; font-size: .85rem; }
    tbody th { grid-area: name; font-size: 1rem; line-height: 1.25; }
    .t-type { grid-area: type; font-size: .9rem; color: var(--texto-suave); }
    .t-page { grid-area: page; font-size: .9rem; color: var(--texto-suave); } .t-page::before { content: 'Pág. '; }
    td.num { grid-area: price; text-align: left; font-size: 1.15rem; }
  }
</style>
